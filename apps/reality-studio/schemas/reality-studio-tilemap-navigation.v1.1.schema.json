{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.local/schemas/reality-studio-tilemap-navigation.v1.1.schema.json",
  "title": "Reality Studio TileMap and Navigation v1.1",
  "type": "object",
  "required": ["format", "version", "tilemap_id", "width", "height", "cell_size", "tileset", "layers", "tilemap_root"],
  "properties": {
    "format": {"const": "reality-studio.tilemap.v1.1"},
    "version": {"const": "1.1.0-alpha.1"},
    "tilemap_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "cell_size": {"type": "integer", "minimum": 1},
    "origin": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}},
      "additionalProperties": false
    },
    "tileset": {
      "type": "object",
      "required": ["format", "tileset_id", "tiles", "tileset_root"],
      "properties": {
        "format": {"const": "reality-studio.tileset.v1.1"},
        "tileset_id": {"type": "string"},
        "tiles": {"type": "object", "minProperties": 1},
        "tileset_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer_id", "kind", "cells"],
        "properties": {
          "layer_id": {"type": "string"},
          "kind": {"enum": ["visual", "collision", "navigation"]},
          "visible": {"type": "boolean"},
          "cells": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "tilemap_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
