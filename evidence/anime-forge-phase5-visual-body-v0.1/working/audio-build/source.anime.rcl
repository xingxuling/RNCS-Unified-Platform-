anime 神临者言律Phase5质量镜头 {
  episode EP01 {
    scene 无名城审判质量镜头 {
      fps 24
      resolution 1280x720
      style japanese_tv_anime

      cut Q01 duration 6s {
        layout perspective_medium
        transition hard_cut

        camera {
          lens 42mm
          angle three_quarter 12deg
          pan from 0s to 6s
          dolly_in from 0s to 6s easing ease_in_out
        }

        background background:unnamed-city-court

        actor 蓝天临 {
          asset character:蓝天临
          keypose 0f head_lowered
          keypose 38f begin_raise_head
          keypose 78f gaze_locked
          keypose 116f resolve
          hold 118f..143f
          gaze 审判官高台 from 72f
          blink at 84f
          blink at 127f

          dialogue {
            text "风会记住你的判词。"
            start 61f
            voice 蓝天临.default
            emotion restrained_question
            mouth automatic_viseme
            close_mouth_on_end true
          }
        }

        animation {
          exposure on_twos
          hair_secondary wind_follow_through
          coat_secondary pressure_follow_through
          motion_override hair from 42f to 132f amplitude 2.2 reason "head-turn-wind-follow-through"
          motion_override coat from 52f to 138f amplitude 1.8 reason "weight-shift-coat-lag"
          motion_override breathing from 0f to 143f amplitude 1.25 reason "held-performance-breath"
          motion_override foreground from 0f to 143f amplitude 2.4 reason "three-plane-parallax"
        }

        sound {
          ambience cold_wind
          foley coat_shift
          sfx distant_bell
          music low_drone
        }
      }
    }
  }
}
