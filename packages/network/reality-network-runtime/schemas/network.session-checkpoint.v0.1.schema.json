{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/network.session-checkpoint.v0.1.schema.json",
  "title": "network.session-checkpoint.v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "protocol",
    "sessionId",
    "status",
    "tick",
    "stateRoot",
    "worldSnapshot",
    "limits",
    "players",
    "delegations",
    "pendingInputs",
    "seenInputSequences",
    "rateByTick",
    "rejections",
    "accepted",
    "receipts",
    "snapshots",
    "deltas",
    "previousTickRoot",
    "authorityHistory",
    "candidateOnly",
    "authoritative",
    "commitStatus",
    "checkpointRoot"
  ],
  "properties": {
    "format": {"const": "network.session-checkpoint.v0.1"},
    "version": {"const": "0.1.0"},
    "protocol": {"const": "rncs.network-runtime.v0.2"},
    "sessionId": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "closed"]},
    "tick": {"type": "integer", "minimum": 0},
    "stateRoot": {"type": "string", "minLength": 1},
    "worldSnapshot": {"type": "object"},
    "limits": {"type": "object"},
    "players": {"type": "array"},
    "delegations": {"type": "array"},
    "pendingInputs": {"type": "array"},
    "seenInputSequences": {"type": "array"},
    "rateByTick": {"type": "array"},
    "rejections": {"type": "array"},
    "accepted": {"type": "array"},
    "receipts": {"type": "array"},
    "snapshots": {"type": "array"},
    "deltas": {"type": "array"},
    "previousTickRoot": {"type": "string"},
    "authorityHistory": {"type": "object"},
    "source": {"type": ["object", "null"]},
    "candidateOnly": {"const": true},
    "authoritative": {"const": false},
    "commitStatus": {"const": "NOT_COMMITTED"},
    "checkpointRoot": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
