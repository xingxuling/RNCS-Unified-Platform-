{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.company/schemas/rncs-formal-proof-receipt.v0.1.schema.json",
  "title": "RNCS Formal Proof Receipt v0.1",
  "type": "object",
  "required": ["theorem", "passed"],
  "properties": {
    "theorem": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "root"],
        "properties": {
          "kind": { "type": "string" },
          "root": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
