{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/subject-identity.v0.1.schema.json",
  "title": "RNCS Subject Identity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "kind",
    "roles",
    "responsibility_boundary"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "human",
        "agent",
        "organization",
        "device",
        "group",
        "observer",
        "system"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "responsibility_boundary": {
      "type": "string",
      "minLength": 1
    },
    "identity_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
