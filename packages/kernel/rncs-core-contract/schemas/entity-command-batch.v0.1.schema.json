{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/entity-command-batch.v0.1.schema.json",
  "title": "RNCS Candidate Entity Command Batch v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "world_id",
    "generation",
    "generation_root",
    "tick",
    "source",
    "profile",
    "command_root",
    "commands",
    "authority",
    "batch_root"
  ],
  "properties": {
    "format": { "const": "rncs.entity-command-batch.v0.1" },
    "version": { "const": "0.1.0" },
    "world_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "generation_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tick": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "plan_id", "state_root", "command_plan_root"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "state_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "command_plan_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "domain", "root"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "command_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "type": "object" }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "canonical_write_authorized", "commit_requires_explicit_rncs_authority"],
      "properties": {
        "candidate_only": { "const": true },
        "canonical_write_authorized": { "const": false },
        "commit_requires_explicit_rncs_authority": { "const": true }
      }
    },
    "batch_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
