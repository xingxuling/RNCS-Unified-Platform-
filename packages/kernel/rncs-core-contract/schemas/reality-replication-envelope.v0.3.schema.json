{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.reality-replication-envelope.v0.3",
  "title": "RNCS Reality State Replication Envelope v0.3",
  "type": "object",
  "required": ["format", "version", "message_type", "message_id", "world_id", "shard_id", "source_node", "target_node", "sequence", "version_root", "base_version_root", "consistency_profile", "consistency_profile_root", "authority_lease", "authority_lease_root", "epoch", "fencing_token", "authority_receipt_root", "payload", "payload_root", "candidate_only", "authoritative", "commit_status", "envelope_root"],
  "$defs": {
    "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consistency": {
      "type": "object",
      "required": ["format", "version", "profile_id", "mode", "stale_read_budget_ms", "authority_required", "conflict_policy", "lease_required", "fencing_required", "retry_policy", "evidence_refs", "candidate_only", "authoritative", "commit_status", "profile_root"],
      "properties": {
        "format": {"const": "rncs.reality-consistency-profile.v0.3"},
        "version": {"const": "0.3.0"},
        "profile_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["LINEARIZABLE", "SERIALIZABLE", "CAUSAL", "SNAPSHOT", "EVENTUAL", "BEST_EFFORT_PROJECTION"]},
        "stale_read_budget_ms": {"type": "integer", "minimum": 0},
        "authority_required": {"type": "boolean"},
        "conflict_policy": {"type": "string", "minLength": 1},
        "lease_required": {"type": "boolean"},
        "fencing_required": {"type": "boolean"},
        "retry_policy": {"type": "object"},
        "evidence_refs": {"type": "array"},
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "commit_status": {"const": "NOT_COMMITTED"},
        "profile_root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": true
    },
    "lease": {
      "type": "object",
      "required": ["format", "version", "authority_id", "shard_id", "semantic_scope", "owner_node", "epoch", "fencing_token", "valid_from_tick", "valid_until_tick", "status", "revoked_at_tick", "renewal_of", "provenance_ref", "authority_ref", "evidence_refs", "candidate_only", "authoritative", "commit_status", "lease_root"],
      "properties": {
        "format": {"const": "rncs.authority-lease.v0.3"},
        "version": {"const": "0.3.0"},
        "authority_id": {"type": "string", "minLength": 1},
        "shard_id": {"type": "string", "minLength": 1},
        "semantic_scope": {"type": "string", "minLength": 1},
        "owner_node": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 0},
        "valid_from_tick": {"type": "integer", "minimum": 0},
        "valid_until_tick": {"type": "integer", "minimum": 0},
        "status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]},
        "revoked_at_tick": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "renewal_of": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
        "provenance_ref": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array"},
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "commit_status": {"const": "NOT_COMMITTED"},
        "lease_root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "format": {"const": "rncs.reality-replication-envelope.v0.3"},
    "version": {"const": "0.3.0"},
    "message_type": {"enum": ["STATE_SNAPSHOT", "STATE_DELTA", "EVENT_DELTA", "REPRESENTATION_DELTA", "INVALIDATE", "LEASE_UPDATE", "AUTHORITY_REVOKE", "ACK", "NACK", "RESYNC_REQUEST"]},
    "message_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "shard_id": {"type": "string", "minLength": 1},
    "source_node": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "version_root": {"$ref": "#/$defs/root"},
    "base_version_root": {"$ref": "#/$defs/root"},
    "consistency_profile": {"anyOf": [{"$ref": "#/$defs/consistency"}, {"type": "null"}]},
    "consistency_profile_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "authority_lease": {"anyOf": [{"$ref": "#/$defs/lease"}, {"type": "null"}]},
    "authority_lease_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "epoch": {"type": "integer", "minimum": 0},
    "fencing_token": {"type": "integer", "minimum": 0},
    "authority_receipt_root": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "payload": {"type": "object"},
    "payload_root": {"$ref": "#/$defs/root"},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "envelope_root": {"$ref": "#/$defs/root"}
  },
  "additionalProperties": true
}
