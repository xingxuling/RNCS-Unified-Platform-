{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/reality-chunk-replication-ack.v0.3.schema.json",
  "title": "RNCS RealityChunk Replication Ack v0.3",
  "type": "object",
  "required": [
    "format", "version", "ack_id", "packet_id", "packet_root", "channel_id",
    "sender_id", "recipient_id", "sequence", "kind", "chunk_id", "payload_root",
    "status", "receipt_root", "error", "resync_for_packet_id", "resync",
    "ack_root", "auth_tag"
  ],
  "properties": {
    "format": {"const": "rncs.reality-chunk-replication-ack.v0.3"},
    "version": {"const": "0.3.0"},
    "ack_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "channel_id": {"type": "string", "minLength": 1},
    "sender_id": {"type": "string", "minLength": 1},
    "recipient_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["DELTA", "SNAPSHOT"]},
    "chunk_id": {"type": "string", "minLength": 1},
    "payload_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["APPLIED", "DUPLICATE", "REJECTED", "RESYNC_REQUIRED"]},
    "receipt_root": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "error": {"type": ["string", "null"]},
    "resync_for_packet_id": {"type": ["string", "null"]},
    "resync": {"type": ["object", "null"]},
    "ack_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "auth_tag": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
