{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/state-reference.v0.1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "id",
    "root",
    "continuity_class"
  ],
  "properties": {
    "kind": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string"
    },
    "continuity_class": {
      "enum": [
        "object_revision",
        "replica_snapshot",
        "execution_session",
        "simulation_snapshot",
        "projection_state",
        "evidence_record",
        "authority_receipt"
      ]
    }
  }
}
