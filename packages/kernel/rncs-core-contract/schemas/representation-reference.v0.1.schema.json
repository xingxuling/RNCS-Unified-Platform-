{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/representation-reference.v0.1.schema.json",
  "title": "RNCS Representation Reference v0.1",
  "type": "object",
  "required": ["format", "version", "representation_id", "provider_id", "provider_root", "representation_kind", "representation_formats", "content_root", "representation_profile", "detail_policy", "residency_policy", "availability", "authority_scope", "authority", "candidate_only", "authoritative", "commit_status", "representation_root"],
  "properties": {
    "format": {"const": "rncs.representation-ref.v0.1"},
    "version": {"const": "0.1.0"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representation_kind": {"type": "string", "minLength": 1},
    "representation_formats": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representation_profile": {"type": "object", "required": ["profile_id", "formats"]},
    "detail_policy": {"type": "object", "required": ["mode"]},
    "residency_policy": {"type": "object", "required": ["mode"]},
    "availability": {"enum": ["CONTRACT_ONLY", "UNAVAILABLE", "CONFIGURED", "AVAILABLE", "EXECUTED"]},
    "authority_scope": {"type": "array", "minItems": 1, "items": {"enum": ["asset_generation_candidate", "representation_candidate", "visual_projection", "observation_candidate"]}},
    "authority": {"type": "object", "properties": {"provider_may_write_authoritative_world_state": {"const": false}, "rncs_authority_required": {"const": true}}},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "representation_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
