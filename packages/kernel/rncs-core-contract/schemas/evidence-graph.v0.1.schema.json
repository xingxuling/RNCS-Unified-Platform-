{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/evidence-graph.v0.1.schema.json",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "evidence_root"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "source",
          "node_root"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
