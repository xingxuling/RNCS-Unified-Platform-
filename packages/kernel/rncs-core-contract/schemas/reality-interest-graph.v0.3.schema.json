{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.reality-interest-graph.v0.3",
  "title": "RNCS Multi-Domain Reality Interest Graph v0.3",
  "type": "object",
  "required": ["format", "version", "subject_id", "graph_revision", "nodes", "edges", "authority", "candidate_only", "authoritative", "commit_status", "graph_root"],
  "$defs": {
    "weight": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "number", "minimum": 0}, {"type": "string", "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"}]},
    "weights": {
      "type": "object",
      "required": ["visual_interest", "audio_interest", "task_interest", "social_interest", "threat_interest", "causal_interest", "authority_interest", "semantic_interest", "history_interest"],
      "properties": {
        "visual_interest": {"$ref": "#/$defs/weight"},
        "audio_interest": {"$ref": "#/$defs/weight"},
        "task_interest": {"$ref": "#/$defs/weight"},
        "social_interest": {"$ref": "#/$defs/weight"},
        "threat_interest": {"$ref": "#/$defs/weight"},
        "causal_interest": {"$ref": "#/$defs/weight"},
        "authority_interest": {"$ref": "#/$defs/weight"},
        "semantic_interest": {"$ref": "#/$defs/weight"},
        "history_interest": {"$ref": "#/$defs/weight"}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["object_id", "weights", "required", "reasons", "evidence_refs"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "weights": {"$ref": "#/$defs/weights"},
        "required": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type", "weight", "evidence_refs"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "type": {"enum": ["visual_interest", "audio_interest", "task_interest", "social_interest", "threat_interest", "causal_interest", "authority_interest", "semantic_interest", "history_interest"]},
        "weight": {"$ref": "#/$defs/weight"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "format": {"const": "rncs.reality-interest-graph.v0.3"},
    "version": {"const": "0.3.0"},
    "subject_id": {"type": "string", "minLength": 1},
    "graph_revision": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "authority": {
      "type": "object",
      "required": ["canonical_owner", "ranking_only", "cannot_mutate_canonical_state"],
      "properties": {"canonical_owner": {"const": "RNCS"}, "ranking_only": {"const": true}, "cannot_mutate_canonical_state": {"const": true}},
      "additionalProperties": true
    },
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "graph_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
