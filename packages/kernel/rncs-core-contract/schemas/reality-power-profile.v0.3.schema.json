{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.reality-power-profile.v0.3",
  "title": "RNCS Reality Power Profile v0.3",
  "type": "object",
  "required": ["format", "version", "profile_id", "node_id", "subject_id", "subject_identity_root", "power_state", "grid_connected", "charging", "battery_percent", "battery_capacity_mwh", "energy_remaining_mwh", "emergency_reserve_mwh", "current_draw_mw", "thermal_celsius_milli", "thermal_throttle_celsius_milli", "thermal_critical_celsius_milli", "thermal_limit_celsius_milli", "thermal_state", "thermal_headroom_celsius_milli", "power_mode", "load_shedding_level", "priority_order", "body_available", "candidate_only", "authoritative", "commit_status", "power_root"],
  "properties": {
    "format": {"const": "rncs.reality-power-profile.v0.3"},
    "version": {"const": "0.3.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "subject_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "subject_identity_root": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "power_state": {"enum": ["GRID", "BATTERY", "CHARGING", "OFFLINE"]},
    "grid_connected": {"type": "boolean"},
    "charging": {"type": "boolean"},
    "battery_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "battery_capacity_mwh": {"type": "integer", "minimum": 0},
    "energy_remaining_mwh": {"type": "integer", "minimum": 0},
    "emergency_reserve_mwh": {"type": "integer", "minimum": 0},
    "current_draw_mw": {"type": "integer", "minimum": 0},
    "thermal_celsius_milli": {"type": "integer", "minimum": -100000, "maximum": 300000},
    "thermal_throttle_celsius_milli": {"type": "integer", "minimum": -100000, "maximum": 300000},
    "thermal_critical_celsius_milli": {"type": "integer", "minimum": -100000, "maximum": 300000},
    "thermal_limit_celsius_milli": {"type": "integer", "minimum": -100000, "maximum": 300000},
    "thermal_state": {"enum": ["NOMINAL", "WARM", "HOT", "CRITICAL"]},
    "thermal_headroom_celsius_milli": {"type": "integer", "minimum": 0},
    "power_mode": {"enum": ["ABUNDANT", "CONSTRAINED", "SURVIVAL", "OFFLINE"]},
    "load_shedding_level": {"enum": ["NONE", "LIGHT", "MODERATE", "SEVERE", "SURVIVAL"]},
    "priority_order": {"type": "array", "uniqueItems": true, "minItems": 4, "items": {"enum": ["SAFETY", "AUTHORITY", "CONTROL", "MINIMUM_REALITY", "COLLISION", "SEMANTIC", "VISUAL", "PHYSICS", "AGENT", "AUDIO", "REFINEMENT"]}},
    "body_available": {"type": "boolean"},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "power_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
