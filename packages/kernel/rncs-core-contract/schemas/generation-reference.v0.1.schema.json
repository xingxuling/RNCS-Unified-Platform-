{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/generation-reference.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reality_id",
    "generation",
    "generation_root"
  ],
  "properties": {
    "reality_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "generation_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
