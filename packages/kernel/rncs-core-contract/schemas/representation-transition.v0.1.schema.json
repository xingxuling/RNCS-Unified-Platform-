{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/rncs/representation-transition.v0.1.schema.json",
  "title": "RNCS Representation Transition Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "transition_id",
    "phase",
    "operation",
    "identity",
    "source_representation",
    "target_representation",
    "equivalence",
    "resource_decision",
    "rollback",
    "active_representation_root",
    "authority",
    "candidate_only",
    "authoritative",
    "commit_status",
    "execution_status",
    "transition_root"
  ],
  "properties": {
    "format": {"const": "rncs.representation-transition.v0.1"},
    "version": {"const": "0.1.0"},
    "transition_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["candidate", "applied", "rolled_back"]},
    "operation": {"type": "string", "minLength": 1},
    "identity": {"type": "object", "required": ["object_id", "branch", "state_root", "content_root", "source_representation_root", "target_representation_root"]},
    "source_representation": {"$ref": "representation-reference.v0.1.schema.json"},
    "target_representation": {"$ref": "representation-reference.v0.1.schema.json"},
    "equivalence": {"type": "object"},
    "resource_decision": {"type": "object"},
    "rollback": {"type": "object"},
    "active_representation_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"type": "object"},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "execution_status": {"enum": ["CANDIDATE_ONLY", "CANDIDATE_APPLIED", "CANDIDATE_ROLLED_BACK"]},
    "transition_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
