{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/integration/taowind-reality-mcp/Dockerfile"
  },
  "deploy": {
    "startCommand": "node packages/integration/taowind-reality-mcp/src/cli.mjs serve",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
