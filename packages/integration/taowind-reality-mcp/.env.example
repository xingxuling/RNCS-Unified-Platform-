TAOWIND_MCP_HOST=127.0.0.1
TAOWIND_MCP_PORT=8787
# Public founder mode without bearer auth requires at least 32 random URL-safe characters.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TAOWIND_MCP_PATH_TOKEN=
TAOWIND_MCP_PUBLIC_BASE_URL=
TAOWIND_MCP_ALLOWED_HOSTS=
TAOWIND_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
TAOWIND_MCP_AUTH_MODE=none
TAOWIND_MCP_BEARER_TOKEN=

# read | candidate | founder
TAOWIND_MCP_AUTHORITY_MODE=founder
TAOWIND_MCP_ENABLE_CANDIDATE_WRITES=true
TAOWIND_MCP_ENABLE_AUTHORITY_WRITES=true
TAOWIND_MCP_REQUIRE_STATE_PRECONDITIONS=true
TAOWIND_MCP_FOUNDER_SUBJECT_ID=subject:duhengjie
TAOWIND_MCP_FOUNDER_APPROVAL_ROLES=owner,security

# disabled | project | founder | founder-unrestricted
TAOWIND_MCP_ENABLE_EXECUTION_TOOLS=true
TAOWIND_EXECUTION_MODE=founder
TAOWIND_EXECUTION_PROVIDER=remote
TAOWIND_EXECUTION_WORKER_URL=https://your-worker.example
# Generate separately from the MCP path token; minimum 24 characters.
TAOWIND_EXECUTION_WORKER_TOKEN=
TAOWIND_EXECUTION_REMOTE_TIMEOUT_MS=1800000

# Only founder-unrestricted plus this explicit flag exposes execution_run_shell.
TAOWIND_EXECUTION_ENABLE_SHELL=false

TAOWIND_MCP_RATE_LIMIT_PER_MINUTE=120
TAOWIND_MCP_SESSION_TTL_MS=1800000
TAOWIND_MCP_TRUST_PROXY=true
