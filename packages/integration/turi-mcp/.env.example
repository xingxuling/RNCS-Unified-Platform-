TURI_HOST=127.0.0.1
TURI_PORT=8797
TURI_MCP_PATH=/mcp
TURI_AUTH_MODE=none
TURI_ALLOWED_HOSTS=127.0.0.1
TURI_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
TURI_MCP_STATELESS=false
TURI_AUTHORITY_MODE=candidate
TURI_ENABLE_AUTHORIZED_WRITES=false
TURI_ENABLE_EXTERNAL_EFFECTS=false
TURI_DATA_DIR=output/turi-mcp
# compat keeps the legacy full catalog; core/research/engineering/world reduce model choice overload.
TURI_TOOL_PROFILE=compat

# Host Intervention Protocol (GPT/host is the primary reasoner)
TURI_REASONING_MODE=host
TURI_HOST_RESUME_TTL_MS=7200000
# Required for public binding; use a random value with at least 32 characters.
TURI_HOST_RESUME_SECRET=

# Local UPDIA / WorldSeed process mode
TURI_UPDIA_ROOT=
TURI_UPDIA_ENTRY=
TURI_UPDIA_STATE_DIR=
TURI_UPDIA_CHECKPOINT=
TURI_UPDIA_KNOWLEDGE_STORE=
TURI_UPDIA_ENDPOINTS=http://127.0.0.1:11435

# Public TURI -> protected UPDIA HTTP bridge mode
TURI_UPDIA_BRIDGE_URL=
TURI_UPDIA_BRIDGE_DISCOVERY_URL=
TURI_UPDIA_BRIDGE_DISCOVERY_FILE=updia-bridge-route.json
TURI_UPDIA_BRIDGE_ALLOWED_HOST_SUFFIXES=.trycloudflare.com
TURI_UPDIA_BRIDGE_DISCOVERY_CACHE_MS=30000
TURI_UPDIA_BRIDGE_DISCOVERY_CACHE_BUST_MS=60000
TURI_UPDIA_BRIDGE_TOKEN=
TURI_UPDIA_BRIDGE_ASYNC=true
TURI_UPDIA_BRIDGE_POLL_MS=1000
TURI_UPDIA_DEFAULT_MAX_TOKENS=512
TURI_UPDIA_DEFAULT_MODEL=

# Optional deployment overrides
TURI_REPO_ROOT=
TURI_RCL_CONTROL_PLANE_DIR=
