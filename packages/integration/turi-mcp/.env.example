TURI_HOST=127.0.0.1
TURI_PORT=8797
TURI_MCP_PATH=/mcp
TURI_AUTH_MODE=none
# For remote deployments use bearer auth and a secret of at least 24 characters.
TURI_BEARER_TOKEN=
TURI_ALLOWED_HOSTS=
TURI_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,http://localhost,http://127.0.0.1
TURI_AUTHORITY_MODE=candidate
TURI_ENABLE_AUTHORIZED_WRITES=false
TURI_ENABLE_EXTERNAL_EFFECTS=false
TURI_AUTHORITY_TOKEN=
TURI_DATA_DIR=
TURI_RCL_ROOT=
# Absolute path to the WorldSeed checkout containing src/updia/local-interaction/cli.mjs.
TURI_UPDIA_ROOT=
TURI_UPDIA_ENTRY=
TURI_UPDIA_STATE_DIR=
# Required on first boot; later boots may use the checkpoint.json persisted in TURI_UPDIA_STATE_DIR.
TURI_UPDIA_CHECKPOINT=
TURI_UPDIA_ENDPOINTS=http://127.0.0.1:11435
# Absolute WorldSeed checkout containing src/cli.mjs.
TURI_GAMEBRAIN_ROOT=
TURI_GAMEBRAIN_CLI=
