{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/rncs.large-world-rsr-terrain-residency-transition.v0.1.schema.json",
  "title": "RNCS Large World RSR Terrain Residency Transition v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "world_id",
    "generation",
    "tick",
    "source_candidate_root",
    "source_region_root",
    "source_world_root",
    "source_stream_root",
    "source_stream_transition_root",
    "managed_tag",
    "entered_body_ids",
    "exited_body_ids",
    "retained_body_ids",
    "source_released_chunk_ids",
    "physical_transition",
    "authority",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "commit_status",
    "transition_root"
  ],
  "properties": {
    "format": {"const": "rncs.large-world-rsr-terrain-residency-transition.v0.1"},
    "version": {"const": "0.1.0"},
    "world_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "tick": {"type": "integer", "minimum": 0},
    "source_candidate_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_region_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_world_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_stream_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_stream_transition_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "managed_tag": {"const": "large-world-terrain"},
    "entered_body_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exited_body_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "retained_body_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_released_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "previous_state_root": {"type": "string", "minLength": 1},
    "next_state_root": {"type": "string", "minLength": 1},
    "previous_body_root": {"type": "string", "minLength": 1},
    "next_body_root": {"type": "string", "minLength": 1},
    "physical_transition": {"type": "object"},
    "authority": {"type": "object"},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "transition_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
