{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/rncs.rcl-rsr-spatial-lowering.v0.1.schema.json",
  "title": "RNCS RCL to RSR Spatial Lowering v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "source_plan_id",
    "source_state_root",
    "source_command_plan_root",
    "source_profile_root",
    "profile",
    "target_format",
    "target_command_root",
    "commands",
    "authority",
    "boundaries",
    "lowering_root"
  ],
  "properties": {
    "format": { "const": "rncs.rcl-rsr-spatial-lowering.v0.1" },
    "version": { "const": "0.1.0" },
    "source_plan_id": { "type": "string", "minLength": 1 },
    "source_state_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_command_plan_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_profile_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile": { "$ref": "#/$defs/profile" },
    "target_format": { "const": "rncs.spatial-command-plan.v0.1" },
    "target_command_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/command" }
    },
    "kernel_command_batch": { "$ref": "#/$defs/kernelCommandBatch" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "authoritative", "canonical_write_authorized", "commit_requires_explicit_rncs_authority"],
      "properties": {
        "candidate_only": { "const": true },
        "authoritative": { "const": false },
        "canonical_write_authorized": { "const": false },
        "commit_requires_explicit_rncs_authority": { "const": true }
      }
    },
    "boundaries": { "type": "array", "items": { "type": "string" } },
    "lowering_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "profile_id", "domain", "candidate_only", "temporal_encoding", "spatial_encoding", "command_families", "command_types", "limits", "root"],
      "properties": {
        "format": { "const": "rcl.physical-command-profile.v0.1" },
        "version": { "const": "0.1.0" },
        "profile_id": { "type": "string", "minLength": 1 },
        "domain": { "const": "spatial" },
        "candidate_only": { "const": true },
        "temporal_encoding": { "const": "integer-tick" },
        "spatial_encoding": { "const": "integer-fixed-point" },
        "command_families": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "command_types": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "limits": { "type": "object" },
        "root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tick", "type", "bodyId", "fixtureId", "samples"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "tick": { "type": "integer", "minimum": 1 },
            "type": { "const": "patch-heightfield" },
            "bodyId": { "type": "string", "minLength": 1 },
            "fixtureId": { "type": "string", "minLength": 1 },
            "samples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "height"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "height": { "type": "integer" }
                }
              }
            },
            "expectedHeightfieldRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tick", "type", "bodyId", "velocity"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "tick": { "type": "integer", "minimum": 1 },
            "type": { "const": "set-velocity" },
            "bodyId": { "type": "string", "minLength": 1 },
            "velocity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z"],
              "properties": {
                "x": { "type": "integer" },
                "y": { "type": "integer" },
                "z": { "type": "integer" }
              }
            }
          }
        }
      ]
    },
    "kernelCommandBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "world_id", "generation", "generation_root", "tick", "source", "profile", "command_root", "commands", "authority", "batch_root"],
      "properties": {
        "format": { "const": "rncs.entity-command-batch.v0.1" },
        "version": { "const": "0.1.0" },
        "world_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 0 },
        "generation_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tick": { "type": "integer", "minimum": 0 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "version", "plan_id", "state_root", "command_plan_root"],
          "properties": {
            "format": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "plan_id": { "type": "string", "minLength": 1 },
            "state_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "command_plan_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "version", "domain", "root"],
          "properties": {
            "format": { "type": "string", "minLength": 1 },
            "version": { "const": "0.1.0" },
            "domain": { "const": "spatial" },
            "root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "command_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commands": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/command" } },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_only", "canonical_write_authorized", "commit_requires_explicit_rncs_authority"],
          "properties": {
            "candidate_only": { "const": true },
            "canonical_write_authorized": { "const": false },
            "commit_requires_explicit_rncs_authority": { "const": true }
          }
        },
        "batch_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
