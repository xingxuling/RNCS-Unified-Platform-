{
  "bundle_id": "policy:hnaf-capability-binding-demo",
  "version": "0.1.0",
  "default_effect": "deny",
  "policies": [
    {
      "policy_id": "allow-owner-low-medium",
      "effect": "allow",
      "priority": 10,
      "match": {
        "roles_any": ["owner"],
        "scopes_any": ["state.*", "capsule.*"],
        "risk_at_most": "medium"
      },
      "obligations": [{"type": "execution-receipt-required"}]
    },
    {
      "policy_id": "approve-high-risk",
      "effect": "require_approval",
      "priority": 60,
      "match": {"risk_at_least": "high"},
      "approval": {"roles": ["owner", "security"], "quorum": 1}
    },
    {
      "policy_id": "deny-critical",
      "effect": "deny",
      "priority": 100,
      "match": {"risk_at_least": "critical"}
    }
  ],
  "metadata": {"purpose": "HNAC v0.8 remote execution demo"}
}
