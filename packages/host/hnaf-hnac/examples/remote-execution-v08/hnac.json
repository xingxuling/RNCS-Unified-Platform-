{
  "format_version": "0.8",
  "app": {
    "id": "org.taowind.hnac.remote-execution-demo",
    "name": "HNAF 远程能力与执行沙盒演示",
    "version": "0.8.0",
    "description": "跨 HTTP、WebSocket、本地进程和内置能力执行，并将回执提交到 RFE Generation"
  },
  "execution": {
    "primary": {
      "profile": "declarative-v0",
      "entry": "components/main.hnc.json"
    },
    "limits": {
      "operations": 100
    }
  },
  "capabilities": [
    {
      "id": "host.log",
      "version": "1",
      "required": true,
      "scope": "session",
      "reason": "显示执行轨迹"
    },
    {
      "id": "storage.state",
      "version": "1",
      "required": true,
      "scope": "app",
      "reason": "保存连续状态"
    }
  ],
  "interface": {
    "version": "0.7",
    "graph": "ui/main.aip.json",
    "default_projection": "auto",
    "intent_policy": {
      "require_confirmation_at_or_above": "high",
      "deny_unknown_intents": true
    }
  },
  "capability_binding": {
    "version": "0.8",
    "providers": "capabilities/providers.json",
    "authority_policy": "authority/policy.json",
    "strategy": {
      "prefer_local": true,
      "offline_first": false,
      "max_fallbacks": 3,
      "max_risk": "high",
      "require_reversible": false,
      "minimum_trust": 1,
      "cost_budget": {
        "cpu_millis": 5000,
        "memory_mb": 256,
        "network_kb": 1024,
        "monetary_microunits": 0
      }
    }
  },
  "execution_fabric": {
    "allowed_transports": [
      "hnaf-builtin",
      "http",
      "websocket",
      "stdio",
      "local-process",
      "reality-one-gateway"
    ],
    "timeout_ms": 2500,
    "max_retries": 1,
    "retry_backoff_ms": 10,
    "resource_quota": {
      "cpu_millis": 5000,
      "memory_mb": 256,
      "network_kb": 512
    },
    "sandbox": {
      "max_output_bytes": 262144,
      "allowed_executables": [
        "python",
        "python3"
      ],
      "allowed_network_hosts": [
        "127.0.0.1",
        "localhost"
      ],
      "environment_allowlist": [
        "PATH",
        "PYTHONPATH"
      ]
    },
    "circuit_breaker": {
      "failure_threshold": 2,
      "reset_seconds": 30
    },
    "idempotency": {
      "ttl_seconds": 86400
    },
    "require_signed_providers": true,
    "commit_receipts_to_rfe": true
  },
  "state": {
    "schema_version": "3",
    "autosnapshot": true,
    "migration_graph": "state/migrations.json",
    "partitions": {
      "portable": {
        "persistence": "durable",
        "portability": "exportable",
        "encrypted": false
      },
      "device_private": {
        "persistence": "durable",
        "portability": "local-only",
        "encrypted": false
      },
      "secret": {
        "persistence": "durable",
        "portability": "encrypted-export",
        "encrypted": true
      },
      "cache": {
        "persistence": "rebuildable",
        "portability": "optional-export",
        "encrypted": false
      },
      "ephemeral": {
        "persistence": "memory",
        "portability": "never-export",
        "encrypted": false
      }
    }
  },
  "distribution": {
    "projections": [
      "pwa",
      "desktop",
      "mobile",
      "accessibility",
      "spatial"
    ]
  },
  "security": {
    "sandbox": "deny-by-default",
    "signature": "optional",
    "supply_chain": "ed25519-required"
  },
  "compatibility": {
    "min_runtime": "0.8.0"
  },
  "extensions": {
    "rncs": {
      "cnp": "0.1.0",
      "aaf": "0.1.0",
      "rfe_core": "0.1.0",
      "gateway": "0.3.0"
    }
  }
}
