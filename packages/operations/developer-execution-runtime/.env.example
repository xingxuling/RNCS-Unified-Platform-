TAOWIND_EXECUTION_WORKER_HOST=127.0.0.1
TAOWIND_EXECUTION_WORKER_PORT=8790
TAOWIND_EXECUTION_WORKER_TOKEN=
TAOWIND_EXECUTION_WORKSPACE_ROOT=/workspace
TAOWIND_EXECUTION_RECEIPT_DIR=/workspace/output/execution-receipts
TAOWIND_EXECUTION_EXPORT_DIR=/workspace/output/execution-exports
TAOWIND_EXECUTION_EXPORT_TTL_MS=3600000
TAOWIND_EXECUTION_WORKER_PUBLIC_BASE_URL=https://your-worker.example

# disabled | project | founder | founder-unrestricted
TAOWIND_EXECUTION_MODE=founder
TAOWIND_EXECUTION_ENABLE_SHELL=false
TAOWIND_EXECUTION_TIMEOUT_MS=120000
TAOWIND_EXECUTION_MAX_OUTPUT_BYTES=1000000
TAOWIND_EXECUTION_ALLOWED_EXECUTABLES=node,npm,npx,python,python3,git,java,javac,gradle,./gradlew,zip

# GitHub fine-grained token: only the bound repository and required Contents/PR/Actions scopes.
TAOWIND_GITHUB_TOKEN=
TAOWIND_GITHUB_OWNER=xingxuling
TAOWIND_GITHUB_REPO=RNCS-Unified-Platform-
TAOWIND_GITHUB_API_BASE=https://api.github.com

# Prefer a project deploy hook for preview redeploys; token/project mode is also supported.
TAOWIND_VERCEL_DEPLOY_HOOK=
TAOWIND_VERCEL_TOKEN=
TAOWIND_VERCEL_PROJECT_ID=
TAOWIND_VERCEL_TEAM_ID=
