{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.example/schemas/asset-provider-manifest.v0.1.schema.json",
  "title": "RAGF Asset Provider Manifest v0.1",
  "type": "object",
  "required": ["format", "contract_version", "id", "name", "version", "providerType", "capabilities", "inputFormats", "outputFormats", "executionMode", "hardwareRequirements", "license", "commercialPolicy", "provenancePolicy", "authority", "manifest_root"],
  "properties": {
    "format": {"const": "ragf.asset-provider-manifest.v0.1"},
    "contract_version": {"const": "0.1.0"},
    "id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "providerType": {"enum": ["3d-production", "procedural-environment", "rigging", "3d-preview", "geometry-refinement", "representation", "generic"]},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputFormats": {"type": "array", "items": {"type": "string"}},
    "outputFormats": {"type": "array", "items": {"type": "string"}},
    "executionMode": {"enum": ["local", "remote", "external-process", "api", "container"]},
    "hardwareRequirements": {"type": "object"},
    "license": {"type": "object", "required": ["status", "identifier"], "properties": {"status": {"enum": ["VERIFIED", "PARTIAL", "UNVERIFIED", "RESTRICTED"]}, "identifier": {"type": ["string", "null"]}}},
    "commercialPolicy": {"type": "object"},
    "provenancePolicy": {"type": "object"},
    "representation": {"type": ["object", "null"], "properties": {"kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "profiles": {"type": "array"}, "detail_policy": {"type": ["object", "null"]}, "residency_policy": {"type": ["object", "null"]}}},
    "authority": {"type": "object", "properties": {"owns_authoritative_world_state": {"const": false}, "may_emit_candidate": {"const": true}, "scope": {"type": "array", "minItems": 1, "items": {"enum": ["asset_generation_candidate", "representation_candidate", "visual_projection", "observation_candidate"]}}}},
    "manifest_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
