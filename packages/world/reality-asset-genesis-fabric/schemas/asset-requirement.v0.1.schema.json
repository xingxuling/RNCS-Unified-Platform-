{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.example/schemas/asset-requirement.v0.1.schema.json",
  "title": "ALWR to RAGF Asset Requirement v0.1",
  "type": "object",
  "required": ["format", "version", "requirement_id", "source", "world_seed", "world_event", "role", "asset_kind", "capabilities", "quality_tier", "selection_policy", "requirement_root"],
  "properties": {
    "format": {"const": "ragf.asset-requirement.v0.1"},
    "version": {"const": "0.1.0"},
    "source": {"const": "ALWR.GameBrain"},
    "world_seed": {"type": "object"},
    "role": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "quality_tier": {"enum": ["PREVIEW", "PRODUCTION", "REFINEMENT", "RIG"]},
    "selection_policy": {"type": "object", "properties": {"require_candidate_only": {"const": true}}},
    "requirement_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
