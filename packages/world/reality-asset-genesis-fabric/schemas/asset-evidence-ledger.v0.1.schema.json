{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.example/schemas/asset-evidence-ledger.v0.1.schema.json",
  "title": "RAGF Asset Evidence Ledger v0.1",
  "type": "object",
  "required": ["format", "version", "ledger_id", "authority", "entries", "status", "roots", "ledger_root"],
  "properties": {
    "format": {"const": "ragf.asset-evidence-ledger.v0.1"},
    "version": {"const": "0.1.0"},
    "authority": {"type": "object", "properties": {"provider_can_write_authoritative_world_state": {"const": false}, "rncs_commit_required": {"const": true}}},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["evidence_id", "status", "root"]}},
    "ledger_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
