{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.example/schemas/ragf-anime-motion-track.v0.1.schema.json",
  "title": "RAGF Anime Motion Track v0.1",
  "type": "object",
  "required": ["format", "version", "asset_id", "identity_root", "palette_root", "proportion_root", "appearance_root", "fps", "frame_count", "loop_mode", "loop_period_frames", "tracks", "frames", "quality_contract", "deterministic", "motion_root"],
  "properties": {
    "format": {"const": "ragf.anime-motion-track.v0.1"},
    "version": {"const": "0.1.0"},
    "fps": {"type": "number", "minimum": 1, "maximum": 60},
    "frame_count": {"type": "integer", "minimum": 2},
    "loop_mode": {"enum": ["cycle", "hold"]},
    "loop_period_frames": {"type": "integer", "minimum": 2},
    "loop_period_seconds": {"type": "number", "exclusiveMinimum": 0},
    "tracks": {"type": "array", "minItems": 4},
    "frames": {"type": "array", "minItems": 2},
    "quality_contract": {"type": "object", "required": ["format", "version", "seam_tolerance", "seam_policy", "required_track_ids", "channels", "quality_root"], "properties": {"format": {"const": "ragf.anime-motion-quality-contract.v0.1"}, "version": {"const": "0.1.0"}, "seam_tolerance": {"type": "number", "minimum": 0}, "seam_policy": {"const": "terminal-frame-equals-first-frame"}, "required_track_ids": {"type": "array", "minItems": 1}, "channels": {"type": "array", "minItems": 1}, "quality_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "deterministic": {"const": true},
    "motion_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
