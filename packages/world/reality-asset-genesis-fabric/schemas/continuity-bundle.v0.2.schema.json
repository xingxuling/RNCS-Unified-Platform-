{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://taowind.example/schemas/continuity-bundle.v0.2.schema.json",
  "title":"Reality Asset Continuity Bundle v0.2",
  "type":"object",
