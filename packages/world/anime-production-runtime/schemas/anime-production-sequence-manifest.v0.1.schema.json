{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.anime-production-sequence-manifest.v0.1",
  "type": "object",
  "required": ["format", "version", "production_id", "production_root", "timeline_root", "quality", "width", "height", "fps", "cut_count", "expected_frame_count", "rendered_frame_count", "frames", "cut_manifests", "deterministic", "status", "sequence_root", "evidence_ledger_root"],
  "properties": {
    "format": {"const": "rncs.anime-production-sequence-manifest.v0.1"},
    "version": {"type": "string"},
    "production_id": {"type": "string", "minLength": 1},
    "production_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "timeline_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "quality": {"enum": ["preview", "standard", "final"]},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "cut_count": {"type": "integer", "minimum": 1},
    "expected_frame_count": {"type": "integer", "minimum": 1},
    "rendered_frame_count": {"type": "integer", "minimum": 0},
    "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
    "cut_manifests": {"type": "array"},
    "deterministic": {"const": true},
    "status": {"enum": ["complete", "partial"]},
    "sequence_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "evidence_ledger_root": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["cut_ref", "local_frame_number", "global_frame_number", "filename", "frame_id", "state_root", "evidence_root"],
      "properties": {
        "cut_ref": {"type": "string", "minLength": 1},
        "local_frame_number": {"type": "integer", "minimum": 0},
        "global_frame_number": {"type": "integer", "minimum": 0},
        "filename": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "state_root": {"type": "string", "minLength": 64, "maxLength": 64},
        "evidence_root": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    }
  }
}
