{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.anime-production-xsheets.v0.1",
  "type": "object",
  "required": ["format", "version", "production_id", "production_root", "timeline_root", "cut_count", "total_frame_count", "sheets", "xsheets_root"],
  "properties": {
    "format": {"const": "rncs.anime-production-xsheets.v0.1"},
    "version": {"type": "string"},
    "production_id": {"type": "string", "minLength": 1},
    "production_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "timeline_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "cut_count": {"type": "integer", "minimum": 1},
    "total_frame_count": {"type": "integer", "minimum": 1},
    "sheets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["cut_ref", "xsheet"], "properties": {"cut_ref": {"type": "string"}, "xsheet": {"$ref": "anime-exposure-sheet.v0.1.schema.json"}}}},
    "xsheets_root": {"type": "string", "minLength": 64, "maxLength": 64}
  }
}
