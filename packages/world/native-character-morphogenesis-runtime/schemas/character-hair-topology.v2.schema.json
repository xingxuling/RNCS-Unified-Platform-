{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs://schemas/character-hair-topology.v2",
  "type": "object",
  "required": ["topology_format", "version", "hair_topology_root", "scalp_anchors", "hairline_curve", "main_hair_masses", "front_bangs_groups", "side_locks", "back_hair_groups", "overlap_order", "motion_chains", "collision_or_face_avoidance", "style_law_bindings"],
  "properties": {
    "topology_format": {"const": "rncs.character-hair-topology"},
    "version": {"const": "2.0.0-alpha.1"},
    "hair_topology_root": {"type": "string", "minLength": 16},
    "scalp_anchors": {"type": "array", "minItems": 6},
    "main_hair_masses": {"type": "array", "minItems": 2},
    "front_bangs_groups": {"type": "array", "minItems": 2},
    "side_locks": {"type": "array", "minItems": 2},
    "back_hair_groups": {"type": "array", "minItems": 1},
    "overlap_order": {"type": "array", "minItems": 5},
    "motion_chains": {"type": "array", "minItems": 2}
  },
  "additionalProperties": true
}
