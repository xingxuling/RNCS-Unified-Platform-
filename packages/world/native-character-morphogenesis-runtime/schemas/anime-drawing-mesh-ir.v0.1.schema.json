{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rncs.anime-drawing-mesh-ir.v0.1",
  "title": "RNCS Anime Drawing Mesh IR v0.1",
  "type": "object",
  "required": ["format", "version", "source_drawing_ir_root", "meshes", "mesh_ir_root"],
  "properties": {
    "format": {"const": "rncs.anime-drawing-mesh-ir.v0.1"},
    "version": {"type": "string"},
    "source_drawing_ir_root": {"type": "string", "minLength": 1},
    "drawing_root": {"type": ["string", "null"]},
    "width": {"type": "number", "exclusiveMinimum": 0},
    "height": {"type": "number", "exclusiveMinimum": 0},
    "lower_body_status": {"type": ["string", "null"]},
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mesh_id", "role", "vertices", "triangles", "cage", "mesh_root"],
        "properties": {
          "mesh_id": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "vertices": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": ["vertex_id", "position", "weights"],
              "properties": {
                "vertex_id": {"type": "string"},
                "position": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
                "weights": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number", "minimum": 0, "maximum": 1}}
              }
            }
          },
          "triangles": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}},
          "cage": {
            "type": "object",
            "required": ["format", "control_points", "bounds"],
            "properties": {
              "format": {"const": "rncs.quadratic-3x3-drawing-cage.v0.1"},
              "control_points": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
            }
          },
          "mesh_root": {"type": "string", "minLength": 1}
        }
      }
    },
    "mesh_ir_root": {"type": "string", "minLength": 1}
  }
}
