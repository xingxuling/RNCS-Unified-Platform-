{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/urrf/universal-art-asset-provider-preflight.v0.1.schema.json",
  "title": "URRF Universal Art Asset Provider Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "preflight_id",
    "source",
    "expected_profiles",
    "providers",
    "profile_routes",
    "license_audit_root",
    "summary",
    "checks",
    "status",
    "execution_performed",
    "aaa_ready",
    "release_ready",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "preflight_root"
  ],
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableRoot": {
      "anyOf": [
        {"$ref": "#/$defs/root"},
        {"type": "null"}
      ]
    },
    "profile": {
      "type": "string",
      "enum": ["character", "creature", "prop", "vehicle", "structure", "environment", "vegetation", "resource", "vfx"]
    },
    "runtime": {
      "type": "string",
      "enum": ["CONTRACT_ONLY", "EXECUTOR_INJECTED", "EXTERNAL_PROCESS"]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    },
    "providerHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime", "runtime_binding"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "runtime": {"$ref": "#/$defs/runtime"},
        "runtime_binding": {"$ref": "#/$defs/runtime"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_status",
        "dependency_status",
        "model_weights_status",
        "data_status",
        "default_commercial_release",
        "blocked_reasons"
      ],
      "properties": {
        "code_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "dependency_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "model_weights_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "data_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "default_commercial_release": {"type": "boolean"},
        "blocked_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "providerChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_root", "health_truthfulness", "license_audit_binding", "profile_binding", "authority_boundary"],
      "properties": {
        "provider_root": {"type": "boolean"},
        "health_truthfulness": {"type": "boolean"},
        "license_audit_binding": {"type": "boolean"},
        "profile_binding": {"type": "boolean"},
        "authority_boundary": {"type": "boolean"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_root",
        "name",
        "version",
        "provider_type",
        "execution_mode",
        "declared_runtime_status",
        "health",
        "runtime_binding",
        "runner_supplied",
        "command_configured",
        "capabilities",
        "profile_bindings",
        "license",
        "authoritative",
        "checks",
        "pass"
      ],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_root": {"$ref": "#/$defs/root"},
        "name": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "version": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "provider_type": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "execution_mode": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "declared_runtime_status": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "health": {"$ref": "#/$defs/health"},
        "runtime_binding": {"$ref": "#/$defs/runtime"},
        "runner_supplied": {"type": "boolean"},
        "command_configured": {"type": "boolean"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "profile_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/profile"}
        },
        "license": {"$ref": "#/$defs/license"},
        "authoritative": {"const": false},
        "checks": {"$ref": "#/$defs/providerChecks"},
        "pass": {"type": "boolean"}
      }
    },
    "routeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_binding", "resolution_root", "provider_binding", "runtime_truthfulness", "no_silent_fallback", "authority_boundary"],
      "properties": {
        "profile_binding": {"type": "boolean"},
        "resolution_root": {"type": "boolean"},
        "provider_binding": {"type": "boolean"},
        "runtime_truthfulness": {"type": "boolean"},
        "no_silent_fallback": {"type": "boolean"},
        "authority_boundary": {"type": "boolean"}
      }
    },
    "routeStatus": {
      "type": "string",
      "enum": ["BUILTIN_REFERENCE_READY", "EXTERNAL_CONTRACT_ONLY", "EXTERNAL_RUNTIME_BOUND", "UNRESOLVED", "INCONSISTENT"]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "asset_profile",
        "asset_id",
        "genome_root",
        "required_capabilities",
        "resolution_root",
        "selected_provider_id",
        "selected_provider_root",
        "selected_provider_source",
        "eligible",
        "runtime_status",
        "provider_health",
        "route_status",
        "checks",
        "pass"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "asset_profile": {"$ref": "#/$defs/profile"},
        "asset_id": {"type": "string", "minLength": 1},
        "genome_root": {"$ref": "#/$defs/root"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "resolution_root": {"$ref": "#/$defs/root"},
        "selected_provider_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "selected_provider_root": {"$ref": "#/$defs/nullableRoot"},
        "selected_provider_source": {
          "anyOf": [
            {"enum": ["ragf-reference-provider", "external-provider-contract", "injected-provider"]},
            {"type": "null"}
          ]
        },
        "eligible": {"type": "boolean"},
        "runtime_status": {"type": "string", "minLength": 1},
        "provider_health": {
          "anyOf": [
            {"$ref": "#/$defs/providerHealth"},
            {"type": "null"}
          ]
        },
        "route_status": {"$ref": "#/$defs/routeStatus"},
        "checks": {"$ref": "#/$defs/routeChecks"},
        "pass": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_count", "provider_count", "route_histogram", "provider_health_histogram", "release_blocked_provider_count"],
      "properties": {
        "profile_count": {"type": "integer", "minimum": 0},
        "provider_count": {"type": "integer", "minimum": 0},
        "route_histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["BUILTIN_REFERENCE_READY", "EXTERNAL_CONTRACT_ONLY", "EXTERNAL_RUNTIME_BOUND", "UNRESOLVED", "INCONSISTENT"],
          "properties": {
            "BUILTIN_REFERENCE_READY": {"type": "integer", "minimum": 0},
            "EXTERNAL_CONTRACT_ONLY": {"type": "integer", "minimum": 0},
            "EXTERNAL_RUNTIME_BOUND": {"type": "integer", "minimum": 0},
            "UNRESOLVED": {"type": "integer", "minimum": 0},
            "INCONSISTENT": {"type": "integer", "minimum": 0}
          }
        },
        "provider_health_histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CONTRACT_ONLY", "EXECUTOR_INJECTED", "EXTERNAL_PROCESS"],
          "properties": {
            "CONTRACT_ONLY": {"type": "integer", "minimum": 0},
            "EXECUTOR_INJECTED": {"type": "integer", "minimum": 0},
            "EXTERNAL_PROCESS": {"type": "integer", "minimum": 0}
          }
        },
        "release_blocked_provider_count": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_coverage",
        "unique_profile_routes",
        "profile_resolution_roots",
        "provider_manifest_roots",
        "provider_health_truthfulness",
        "license_audit_root",
        "no_silent_external_execution",
        "authority_boundary"
      ],
      "properties": {
        "profile_coverage": {"type": "boolean"},
        "unique_profile_routes": {"type": "boolean"},
        "profile_resolution_roots": {"type": "boolean"},
        "provider_manifest_roots": {"type": "boolean"},
        "provider_health_truthfulness": {"type": "boolean"},
        "license_audit_root": {"type": "boolean"},
        "no_silent_external_execution": {"type": "boolean"},
        "authority_boundary": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_owner",
        "representation_owner",
        "provider_can_write_authoritative_world_state",
        "provider_can_commit",
        "acceptance_can_commit",
        "rncs_authority_required"
      ],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "acceptance_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      }
    }
  },
  "properties": {
    "format": {"const": "urrf.universal-art-asset-provider-preflight.v0.1"},
    "version": {"const": "0.1.0"},
    "preflight_id": {"type": "string", "minLength": 1},
    "source": {"const": "urrf-provider-preflight-evaluator"},
    "expected_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/provider"}
    },
    "profile_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/route"}
    },
    "license_audit_root": {"$ref": "#/$defs/root"},
    "summary": {"$ref": "#/$defs/summary"},
    "checks": {"$ref": "#/$defs/checks"},
    "status": {"enum": ["CANDIDATE_PROVIDER_PREFLIGHT_PASS", "CANDIDATE_PROVIDER_PREFLIGHT_FAIL"]},
    "execution_performed": {"const": false},
    "aaa_ready": {"const": false},
    "release_ready": {"const": false},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "preflight_root": {"$ref": "#/$defs/root"}
  }
}
