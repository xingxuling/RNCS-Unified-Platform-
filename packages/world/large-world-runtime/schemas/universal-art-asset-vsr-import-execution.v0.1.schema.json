{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-vsr-import-execution.v0.1.schema.json",
  "title": "URRF Universal Art Asset VSR Import Execution Report v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "execution_id",
    "materialization_root",
    "projection_root",
    "assembly_root",
    "scene_id",
    "world_id",
    "status",
    "runtime_consumer",
    "streaming_receipt_root",
    "asset_count",
    "catalog_asset_count",
    "streamed_asset_count",
    "streamed_mesh_asset_count",
    "streamed_texture_asset_count",
    "imported_asset_count",
    "frame_count",
    "total_triangle_count",
    "total_texture_count",
    "total_material_texture_binding_count",
    "external_pbr_channel_count",
    "texture_decode_mode",
    "pbr_binding_mode",
    "render_mode",
    "rendered_asset_count",
    "total_rendered_png_byte_length",
    "total_rendered_non_background_pixel_count",
    "actual_gpu_execution",
    "target_device_execution",
    "assets",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "report_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-vsr-import-execution-report.v0.1"},
    "version": {"const": "0.1.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "materialization_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projection_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assembly_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scene_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "status": {"const": "CANDIDATE_LOCAL_CPU_PASS"},
    "runtime_consumer": {"const": "VSR_GLTF_IMPORT"},
    "streaming_receipt_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "catalog_asset_count": {"type": "integer", "minimum": 1, "maximum": 320},
    "streamed_asset_count": {"type": "integer", "minimum": 0, "maximum": 320},
    "streamed_mesh_asset_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "streamed_texture_asset_count": {"type": "integer", "minimum": 0, "maximum": 256},
    "imported_asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "total_triangle_count": {"type": "integer", "minimum": 1},
    "total_texture_count": {"type": "integer", "minimum": 0},
    "total_material_texture_binding_count": {"type": "integer", "minimum": 0},
    "external_pbr_channel_count": {"type": "integer", "minimum": 0, "maximum": 256},
    "texture_decode_mode": {"const": "node-png-decode"},
    "pbr_binding_mode": {"const": "vsr-external-channel-adapter"},
    "render_mode": {"const": "vsr-cpu-reference-raster"},
    "rendered_asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "total_rendered_png_byte_length": {"type": "integer", "minimum": 1},
    "total_rendered_non_background_pixel_count": {"type": "integer", "minimum": 1},
    "actual_gpu_execution": {"const": false},
    "target_device_execution": {"const": false},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "asset_key",
          "selected_lod",
          "placement_mm",
          "import_receipt_root",
          "scene_root",
          "frame_root",
          "mesh_count",
          "texture_count",
          "material_texture_binding_count",
          "triangle_count",
          "pbr_channel_count",
          "pbr_byte_length",
          "rendered_png_byte_length",
          "rendered_pixel_root",
          "rendered_non_background_pixel_count"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "asset_key": {"type": "string", "minLength": 1},
          "selected_lod": {"type": "integer", "minimum": 0, "maximum": 32},
          "placement_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": -1000000, "maximum": 1000000}},
          "import_receipt_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "scene_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "frame_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "mesh_count": {"type": "integer", "minimum": 1},
          "texture_count": {"type": "integer", "minimum": 0},
          "material_texture_binding_count": {"type": "integer", "minimum": 0},
          "triangle_count": {"type": "integer", "minimum": 1},
          "pbr_channel_count": {"type": "integer", "minimum": 4, "maximum": 4},
          "pbr_byte_length": {"type": "integer", "minimum": 1},
          "rendered_png_byte_length": {"type": "integer", "minimum": 1},
          "rendered_pixel_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rendered_non_background_pixel_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {
      "type": "object",
      "required": [
        "canonical_owner",
        "representation_owner",
        "provider_can_write_authoritative_world_state",
        "provider_can_commit",
        "acceptance_can_commit",
        "rncs_authority_required"
      ],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "acceptance_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "report_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
