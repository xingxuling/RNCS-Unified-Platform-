{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-vsr-materialization.v0.1.schema.json",
  "title": "URRF Universal Art Asset VSR Payload Materialization v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "materialization_id",
    "projection_root",
    "assembly_root",
    "batch_root",
    "source_reality_root",
    "placement_root",
    "streaming_root",
    "scene_id",
    "world_id",
    "source_status",
    "status",
    "runtime_consumer",
    "asset_count",
    "assets",
    "dependency_count",
    "dependencies",
    "total_byte_length",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "materialization_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-vsr-materialization.v0.1"},
    "version": {"const": "0.1.0"},
    "materialization_id": {"type": "string", "minLength": 1},
    "projection_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assembly_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "batch_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_reality_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "placement_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "streaming_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scene_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "source_status": {"enum": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"]},
    "status": {"const": "READY_FOR_VSR_IMPORT"},
    "runtime_consumer": {"const": "VSR_GLTF_IMPORT"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri",
          "format",
          "kind",
          "sha256",
          "byte_length",
          "file_root",
          "relative_path",
          "output_directory",
          "selected_lod",
          "dependencies",
          "cell_ids",
          "priority",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "format": {"const": "model/gltf-binary"},
          "kind": {"const": "mesh"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "byte_length": {"type": "integer", "minimum": 1},
          "file_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "relative_path": {"type": "string", "minLength": 1},
          "output_directory": {"type": "string", "minLength": 1},
          "selected_lod": {"type": "integer", "minimum": 0, "maximum": 32},
          "dependencies": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
          "cell_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "priority": {"type": "integer", "minimum": 1},
          "status": {"const": "MATERIALIZED"}
        },
        "additionalProperties": false
      }
    },
    "dependency_count": {"type": "integer", "minimum": 4, "maximum": 256},
    "dependencies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri",
          "format",
          "kind",
          "sha256",
          "byte_length",
          "file_root",
          "relative_path",
          "output_directory",
          "role",
          "pbr_pack_root",
          "cell_ids",
          "priority",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "format": {"type": "string", "pattern": "^image/[^\\s]+$"},
          "kind": {"const": "texture"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "byte_length": {"type": "integer", "minimum": 1},
          "file_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "relative_path": {"type": "string", "minLength": 1},
          "output_directory": {"type": "string", "minLength": 1},
          "role": {"enum": ["base-color", "normal", "occlusion-roughness-metallic", "emissive"]},
          "pbr_pack_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "cell_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "priority": {"type": "integer", "minimum": 1},
          "status": {"const": "MATERIALIZED"}
        },
        "additionalProperties": false
      }
    },
    "total_byte_length": {"type": "integer", "minimum": 1},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {
      "type": "object",
      "required": [
        "canonical_owner",
        "representation_owner",
        "provider_can_write_authoritative_world_state",
        "provider_can_commit",
        "acceptance_can_commit",
        "rncs_authority_required"
      ],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "acceptance_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "materialization_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
