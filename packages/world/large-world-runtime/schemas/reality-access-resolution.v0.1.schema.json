{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/rncs.large-world-reality-access-resolution.v0.1.schema.json",
  "title": "RNCS Large World Reality Access Resolution v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "world_id",
    "generation",
    "region_root",
    "world_root",
    "subject_id",
    "horizon",
    "query",
    "query_result",
    "working_set",
    "stream_resolution",
    "stream_root",
    "active_chunk_ids",
    "selected_object_ids",
    "selected_chunk_ids",
    "active_selected_chunk_ids",
    "unresolved_object_ids",
    "unresolved_chunk_ids",
    "forced_chunk_ids",
    "canonical_state_mutated",
    "candidate_only",
    "authoritative",
    "commit_status",
    "resolution_root"
  ],
  "properties": {
    "format": {"const": "rncs.large-world-reality-access-resolution.v0.1"},
    "version": {"const": "0.1.0"},
    "world_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "region_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "world_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "horizon": {"type": "object"},
    "interest_graph": {"type": ["object", "null"]},
    "query": {"type": "object"},
    "query_result": {"type": "object"},
    "working_set": {"type": "object"},
    "stream_resolution": {"type": "object"},
    "stream_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "active_selected_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forced_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "canonical_state_mutated": {"const": false},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "resolution_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
