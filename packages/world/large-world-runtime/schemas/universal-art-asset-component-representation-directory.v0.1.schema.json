{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-component-representation-directory.v0.1.schema.json",
  "title": "URRF Universal Art Asset Component Representation Directory v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "directory_id",
    "source",
    "component_assembly_root",
    "assembly_status",
    "scene_id",
    "world_id",
    "component_count",
    "representation_count",
    "representations",
    "representation_refs",
    "resource_count",
    "resources",
    "vsr_catalog",
    "rsr_observation_inputs",
    "rsr_observation_input_root",
    "summary",
    "checks",
    "status",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "aaa_ready",
    "release_ready",
    "authority",
    "directory_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-component-representation-directory.v0.1"},
    "version": {"const": "0.1.0"},
    "directory_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {"const": "urrf-component-assembly-representation-lowering"},
    "component_assembly_root": {"$ref": "#/$defs/root"},
    "assembly_status": {"enum": ["CANDIDATE_COMPONENT_ASSEMBLY_READY", "CANDIDATE_COMPONENT_ASSEMBLY_BLOCKED"]},
    "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "component_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "representation_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "representations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/representation"}},
    "representation_refs": {"type": "array", "items": {"$ref": "#/$defs/representationRef"}},
    "resource_count": {"type": "integer", "minimum": 0, "maximum": 16384},
    "resources": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/vsrAsset"}},
    "vsr_catalog": {"$ref": "#/$defs/vsrCatalog"},
    "rsr_observation_inputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/rsrInput"}},
    "rsr_observation_input_root": {"$ref": "#/$defs/root"},
    "summary": {"type": "object", "required": ["representation_count", "reference_count", "resource_count", "vsr_asset_count", "rsr_input_count", "representation_kind_counts", "vsr_catalog_kind_counts"], "additionalProperties": false, "properties": {
      "representation_count": {"type": "integer", "minimum": 1},
      "reference_count": {"type": "integer", "minimum": 0},
      "resource_count": {"type": "integer", "minimum": 0},
      "vsr_asset_count": {"type": "integer", "minimum": 0},
      "rsr_input_count": {"type": "integer", "minimum": 1},
      "representation_kind_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
      "vsr_catalog_kind_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
    }},
    "checks": {"type": "object", "required": ["assembly_binding", "representation_reference_binding", "provider_binding", "representation_kind_preservation", "representation_resource_binding", "vsr_catalog_integrity", "rsr_observation_boundary", "transform_binding", "authority_boundary"], "additionalProperties": false, "properties": {
      "assembly_binding": {"type": "boolean"},
      "representation_reference_binding": {"type": "boolean"},
      "provider_binding": {"type": "boolean"},
      "representation_kind_preservation": {"type": "boolean"},
      "representation_resource_binding": {"type": "boolean"},
      "vsr_catalog_integrity": {"type": "boolean"},
      "rsr_observation_boundary": {"type": "boolean"},
      "transform_binding": {"type": "boolean"},
      "authority_boundary": {"type": "boolean"}
    }},
    "status": {"enum": ["CANDIDATE_REPRESENTATION_DIRECTORY_READY", "CANDIDATE_REPRESENTATION_DIRECTORY_BLOCKED"]},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "aaa_ready": {"const": false},
    "release_ready": {"const": false},
    "authority": {"type": "object", "required": ["canonical_owner", "representation_owner", "provider_can_write_authoritative_world_state", "provider_can_commit", "composition_can_commit", "rsr_can_promote_without_independent_evidence", "rncs_authority_required"], "additionalProperties": false, "properties": {
      "canonical_owner": {"const": "RNCS"},
      "representation_owner": {"const": "URRF"},
      "provider_can_write_authoritative_world_state": {"const": false},
      "provider_can_commit": {"const": false},
      "composition_can_commit": {"const": false},
      "rsr_can_promote_without_independent_evidence": {"const": false},
      "rncs_authority_required": {"const": true}
    }},
    "directory_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableRoot": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "nullableText": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "kind": {"enum": ["mesh", "sdf", "voxel", "point-cloud", "gaussian-splat", "neural-field", "curve", "particle", "material", "rig", "animation"]},
    "transform": {"type": "object", "required": ["translation_mm", "rotation_deg", "scale_milli"], "additionalProperties": false, "properties": {
      "translation_mm": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "minItems": 3, "maxItems": 3},
      "rotation_deg": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "minItems": 3, "maxItems": 3},
      "scale_milli": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 3, "maxItems": 3}
    }},
    "representationProfile": {"type": "object", "required": ["profile_id", "formats"], "additionalProperties": true, "properties": {"profile_id": {"type": "string", "minLength": 1}, "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "representationRef": {"type": "object", "required": ["format", "version", "representation_id", "provider_id", "provider_root", "representation_kind", "representation_formats", "content_root", "representation_profile", "detail_policy", "residency_policy", "availability", "authority_scope", "authority", "candidate_only", "authoritative", "commit_status", "representation_root"], "additionalProperties": true, "properties": {
      "format": {"const": "rncs.representation-ref.v0.1"},
      "version": {"const": "0.1.0"},
      "representation_id": {"type": "string", "minLength": 1},
      "provider_id": {"type": "string", "minLength": 1},
      "provider_root": {"$ref": "#/$defs/root"},
      "representation_kind": {"$ref": "#/$defs/kind"},
      "representation_formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "content_root": {"$ref": "#/$defs/root"},
      "representation_profile": {"$ref": "#/$defs/representationProfile"},
      "detail_policy": {"type": "object", "required": ["mode"], "additionalProperties": true, "properties": {"mode": {"type": "string", "minLength": 1}}},
      "residency_policy": {"type": "object", "required": ["mode"], "additionalProperties": true, "properties": {"mode": {"type": "string", "minLength": 1}}},
      "availability": {"enum": ["CONTRACT_ONLY", "UNAVAILABLE", "CONFIGURED", "AVAILABLE", "EXECUTED"]},
      "authority_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "authority": {"type": "object", "properties": {"provider_may_write_authoritative_world_state": {"const": false}, "rncs_authority_required": {"const": true}}},
      "candidate_only": {"const": true},
      "authoritative": {"const": false},
      "commit_status": {"const": "NOT_COMMITTED"},
      "representation_root": {"$ref": "#/$defs/root"}
    }},
    "representation": {"type": "object", "required": ["component_id", "component_root", "representation_id", "representation_root", "representation_kind", "representation_profile", "content_root", "resource_ids", "transform", "provider_stage_ids", "provider_id", "provider_root", "representation_ref", "consumer_mapping", "candidate_only", "authoritative", "entry_root"], "additionalProperties": false, "properties": {
      "component_id": {"type": "string", "minLength": 1},
      "component_root": {"$ref": "#/$defs/root"},
      "representation_id": {"$ref": "#/$defs/nullableText"},
      "representation_root": {"$ref": "#/$defs/nullableRoot"},
      "representation_kind": {"$ref": "#/$defs/kind"},
      "representation_profile": {"type": "string", "minLength": 1},
      "content_root": {"$ref": "#/$defs/root"},
      "resource_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "transform": {"$ref": "#/$defs/transform"},
      "provider_stage_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "provider_id": {"$ref": "#/$defs/nullableText"},
      "provider_root": {"$ref": "#/$defs/nullableRoot"},
      "representation_ref": {"anyOf": [{"$ref": "#/$defs/representationRef"}, {"type": "null"}]},
      "consumer_mapping": {"type": "object", "required": ["vsr", "rsr"], "additionalProperties": false, "properties": {
        "vsr": {"type": "object", "required": ["target_contract", "catalog_kind", "asset_ids", "stream_status", "direct_import_status"], "additionalProperties": false, "properties": {"target_contract": {"const": "vsr.spatial-asset-streaming.v0.1"}, "catalog_kind": {"enum": ["mesh", "material", "animation", "other"]}, "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "stream_status": {"enum": ["CATALOG_READY", "BLOCKED"]}, "direct_import_status": {"const": "NOT_EXECUTED"}}},
        "rsr": {"type": "object", "required": ["target_contract", "observation_input_status", "observation_kinds", "execution_status", "reconstruction_status"], "additionalProperties": false, "properties": {"target_contract": {"const": "rsr.representation-observation-candidate.v0.1"}, "observation_input_status": {"enum": ["INPUT_READY", "BLOCKED"]}, "observation_kinds": {"type": "array", "items": {"enum": ["bounds", "lod", "residency"]}}, "execution_status": {"const": "NOT_EXECUTED"}, "reconstruction_status": {"const": "FORBIDDEN_IN_THIS_LAYER"}}}
      }},
      "candidate_only": {"const": true},
      "authoritative": {"const": false},
      "entry_root": {"$ref": "#/$defs/root"}
    }},
    "vsrAsset": {"type": "object", "required": ["id", "uri", "format", "sha256", "byteLength", "kind", "dependencies", "cellIds", "priority", "metadata"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1},
      "uri": {"type": "string", "minLength": 1},
      "format": {"type": "string", "minLength": 1},
      "sha256": {"$ref": "#/$defs/root"},
      "byteLength": {"type": "integer", "minimum": 1},
      "kind": {"enum": ["mesh", "material", "animation", "other"]},
      "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "cellIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "priority": {"type": "integer", "minimum": 1},
      "metadata": {"type": "object", "required": ["source", "assembly_root", "component_id", "component_root", "representation_id", "representation_root", "representation_kind", "representation_profile", "vsr_kind", "import_status", "resource_id", "resource_root", "stage_id", "role", "relative_path", "output_directory", "byte_length", "sha256", "transform", "candidate_only", "authoritative"], "properties": {"source": {"const": "urrf.universal-art-asset-component-assembly.v0.1"}, "assembly_root": {"$ref": "#/$defs/root"}, "component_id": {"type": "string", "minLength": 1}, "component_root": {"$ref": "#/$defs/root"}, "representation_id": {"$ref": "#/$defs/nullableText"}, "representation_root": {"$ref": "#/$defs/nullableRoot"}, "representation_kind": {"$ref": "#/$defs/kind"}, "representation_profile": {"type": "string", "minLength": 1}, "vsr_kind": {"enum": ["mesh", "material", "animation", "other"]}, "import_status": {"const": "NOT_EXECUTED"}, "resource_id": {"type": "string", "minLength": 1}, "resource_root": {"$ref": "#/$defs/root"}, "stage_id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "output_directory": {"type": "string", "minLength": 1}, "byte_length": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/root"}, "transform": {"$ref": "#/$defs/transform"}, "candidate_only": {"const": true}, "authoritative": {"const": false}}, "additionalProperties": true}
    }},
    "vsrCatalog": {"type": "object", "required": ["format", "version", "catalog_root", "asset_count", "assets"], "additionalProperties": false, "properties": {"format": {"const": "vsr.spatial-asset-streaming.v0.1"}, "version": {"const": "0.1.0"}, "catalog_root": {"$ref": "#/$defs/root"}, "asset_count": {"type": "integer", "minimum": 0}, "assets": {"type": "array", "items": {"$ref": "#/$defs/vsrAsset"}}}},
    "rsrInput": {"type": "object", "required": ["target_contract", "representation_id", "representation_root", "representation_kind", "content_root", "observation_kinds", "status", "execution_status", "candidate_creation", "reconstruction_candidate", "canonical_state_proposal", "authority", "candidate_only", "authoritative", "commit_status", "input_root"], "additionalProperties": false, "properties": {"target_contract": {"const": "rsr.representation-observation-candidate.v0.1"}, "representation_id": {"$ref": "#/$defs/nullableText"}, "representation_root": {"$ref": "#/$defs/nullableRoot"}, "representation_kind": {"$ref": "#/$defs/kind"}, "content_root": {"$ref": "#/$defs/root"}, "observation_kinds": {"type": "array", "minItems": 3, "items": {"enum": ["bounds", "lod", "residency"]}}, "status": {"enum": ["INPUT_READY", "BLOCKED"]}, "execution_status": {"const": "NOT_EXECUTED"}, "candidate_creation": {"const": "DEFERRED_TO_RSR"}, "reconstruction_candidate": {"type": "null"}, "canonical_state_proposal": {"type": "null"}, "authority": {"type": "object", "required": ["provider_can_write_authoritative_world_state", "rsr_can_promote_without_independent_evidence", "rncs_authority_required"], "additionalProperties": false, "properties": {"provider_can_write_authoritative_world_state": {"const": false}, "rsr_can_promote_without_independent_evidence": {"const": false}, "rncs_authority_required": {"const": true}}}, "candidate_only": {"const": true}, "authoritative": {"const": false}, "commit_status": {"const": "NOT_COMMITTED"}, "input_root": {"$ref": "#/$defs/root"}}}
  },
  "additionalProperties": false
}
