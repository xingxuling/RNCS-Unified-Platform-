{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-vsr-webgpu-browser-receipt.v0.1.schema.json",
  "title": "URRF Universal Art Asset VSR WebGPU Browser Receipt v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "status",
    "capability",
    "source_reality_root",
    "assembly_root",
    "projection_root",
    "materialization_root",
    "frame_root",
    "cpu_frame_root",
    "receipt",
    "receipt_frame_root_matches_cpu",
    "performance_root",
    "performance_report",
    "performance_sample_count",
    "performance_budget_status",
    "png",
    "png_sha256",
    "png_bytes",
    "page_errors",
    "shader_messages",
    "failed_requests",
    "authority",
    "notes"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-vsr-webgpu-browser-receipt.v0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "EXECUTED"},
    "capability": {
      "type": "object",
      "required": ["format", "available", "secureContext", "features", "limits", "requiredFeatures", "requiredLimits", "missingFeatures", "missingLimits", "reason"],
      "properties": {
        "format": {"const": "vsr.spatial-webgpu-capabilities.v0.4"},
        "available": {"const": true},
        "secureContext": {"const": true},
        "features": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "object", "additionalProperties": {"type": "number"}},
        "requiredFeatures": {"type": "array", "items": {"type": "string"}},
        "requiredLimits": {"type": "object", "additionalProperties": {"type": "number"}},
        "missingFeatures": {"type": "array", "maxItems": 0},
        "missingLimits": {"type": "object", "maxProperties": 0},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source_reality_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assembly_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projection_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "materialization_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frame_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cpu_frame_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receipt": {
      "type": "object",
      "required": [
        "format",
        "frameRoot",
        "sceneId",
        "adapterName",
        "drawCalls",
        "triangles",
        "submitted",
        "deviceLost",
        "compileMs",
        "uploadMs",
        "encodeMs",
        "submitMs",
        "materialTextureBindings",
        "shadowPasses",
        "velocityPasses",
        "toneMapPasses",
        "ssgiPasses",
        "irradianceCacheProbes",
        "visibleInstances",
        "instancedDraws",
        "gpuDrivenDraws",
        "gpuDrivenShadowDraws",
        "textureBytesResident",
        "textureUploads",
        "textureEvictions",
        "bufferBytesResident",
        "bufferUploads",
        "bufferEvictions",
        "irradianceVolumeSamples",
        "receiptRoot"
      ],
      "properties": {
        "format": {"const": "vsr.spatial-webgpu-receipt.v0.4"},
        "frameRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sceneId": {"type": "string", "minLength": 1},
        "adapterName": {"type": "string"},
        "drawCalls": {"type": "integer", "minimum": 0},
        "triangles": {"type": "integer", "minimum": 1},
        "submitted": {"const": true},
        "deviceLost": {"const": false},
        "compileMs": {"type": "number", "minimum": 0},
        "uploadMs": {"type": "number", "minimum": 0},
        "encodeMs": {"type": "number", "minimum": 0},
        "submitMs": {"type": "number", "minimum": 0},
        "materialTextureBindings": {"type": "integer", "minimum": 0},
        "shadowPasses": {"type": "integer", "minimum": 0},
        "velocityPasses": {"type": "integer", "minimum": 0},
        "toneMapPasses": {"type": "integer", "minimum": 0},
        "ssgiPasses": {"type": "integer", "minimum": 0},
        "irradianceCacheProbes": {"type": "integer", "minimum": 0},
        "visibleInstances": {"type": "integer", "minimum": 0},
        "instancedDraws": {"type": "integer", "minimum": 0},
        "gpuDrivenDraws": {"type": "integer", "minimum": 0},
        "gpuDrivenShadowDraws": {"type": "integer", "minimum": 0},
        "textureBytesResident": {"type": "integer", "minimum": 0},
        "textureUploads": {"type": "integer", "minimum": 0},
        "textureEvictions": {"type": "integer", "minimum": 0},
        "bufferBytesResident": {"type": "integer", "minimum": 0},
        "bufferUploads": {"type": "integer", "minimum": 0},
        "bufferEvictions": {"type": "integer", "minimum": 0},
        "irradianceVolumeSamples": {"type": "integer", "minimum": 0},
        "receiptRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "receipt_frame_root_matches_cpu": {"const": true},
    "performance_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "performance_report": {"type": "string", "minLength": 1},
    "performance_sample_count": {"type": "integer", "minimum": 2},
    "performance_budget_status": {"const": "PASS"},
    "png": {"type": "string", "minLength": 1},
    "png_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "png_bytes": {"type": "integer", "minimum": 1},
    "page_errors": {"type": "array", "maxItems": 0},
    "shader_messages": {"type": "array", "maxItems": 0},
    "failed_requests": {"type": "array", "maxItems": 0},
    "authority": {
      "type": "object",
      "required": ["candidate_only", "authoritative", "canonical_write_authorized"],
      "properties": {
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "canonical_write_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
