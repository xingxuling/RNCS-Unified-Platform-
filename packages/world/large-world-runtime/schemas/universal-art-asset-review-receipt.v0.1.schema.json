{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-review-receipt.v0.1.schema.json",
  "title": "URRF Universal Art Asset Review Receipt v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "review_kind",
    "source",
    "receipt_status",
    "decision",
    "reviewer_id",
    "reviewer_role",
    "genome_root",
    "candidate_root",
    "file_inspection_root",
    "reference_root",
    "comparison",
    "verifier",
    "attestation",
    "receipt_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-review-receipt.v0.1"},
    "version": {"const": "0.1.0"},
    "review_kind": {"enum": ["ART_DIRECTION", "HUMAN_ART"]},
    "source": {"const": "external-human-review"},
    "receipt_status": {"const": "VERIFIED"},
    "decision": {"const": "APPROVED"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "genome_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_inspection_root": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reference_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "comparison": {
      "type": "object",
      "required": ["comparison_root", "axes"],
      "properties": {
        "comparison_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["axis", "status"],
            "properties": {
              "axis": {"type": "string", "minLength": 1},
              "status": {"const": "PASS"},
              "note": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "required": ["kind", "status", "verifier_id", "method"],
      "properties": {
        "kind": {"const": "external-review-verifier"},
        "status": {"const": "PASS"},
        "verifier_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "attestation": {"enum": ["ART_DIRECTION_REVIEWED", "HUMAN_REVIEWED"]},
    "notes": {"type": "string"},
    "receipt_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"review_kind": {"const": "ART_DIRECTION"}}},
      "then": {"properties": {"attestation": {"const": "ART_DIRECTION_REVIEWED"}}}
    },
    {
      "if": {"properties": {"review_kind": {"const": "HUMAN_ART"}}},
      "then": {"properties": {"attestation": {"const": "HUMAN_REVIEWED"}}}
    }
  ]
}
