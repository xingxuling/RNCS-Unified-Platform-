{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-component-representation-import-execution.v0.1.schema.json",
  "title": "URRF Universal Art Asset Component Representation Import Execution v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "execution_id",
    "directory_root",
    "component_assembly_root",
    "scene_id",
    "world_id",
    "source_status",
    "runtime_consumer",
    "execution_mode",
    "status",
    "selected_component_ids",
    "component_count",
    "entries",
    "summary",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "report_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-component-representation-import-execution.v0.1"},
    "version": {"const": "0.1.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "directory_root": {"$ref": "#/$defs/root"},
    "component_assembly_root": {"$ref": "#/$defs/root"},
    "scene_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "source_status": {"enum": ["CANDIDATE_REPRESENTATION_DIRECTORY_READY", "CANDIDATE_REPRESENTATION_DIRECTORY_BLOCKED"]},
    "runtime_consumer": {"const": "VSR_REPRESENTATION_IMPORT_ADAPTER"},
    "execution_mode": {"const": "INJECTED_CONSUMER_ADAPTER"},
    "status": {"enum": [
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_EXECUTED",
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_PARTIAL",
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_PARTIAL_FAILED",
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_FAILED",
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_BLOCKED",
      "CANDIDATE_COMPONENT_REPRESENTATION_IMPORT_NOT_RUN"
    ]},
    "selected_component_ids": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
    "component_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "entries": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/entry"}},
    "summary": {"type": "object", "required": ["selected_component_count", "executed_count", "blocked_count", "failed_count", "not_run_count", "total_loaded_byte_length"], "additionalProperties": false, "properties": {
      "selected_component_count": {"type": "integer", "minimum": 1, "maximum": 128},
      "executed_count": {"type": "integer", "minimum": 0, "maximum": 128},
      "blocked_count": {"type": "integer", "minimum": 0, "maximum": 128},
      "failed_count": {"type": "integer", "minimum": 0, "maximum": 128},
      "not_run_count": {"type": "integer", "minimum": 0, "maximum": 128},
      "total_loaded_byte_length": {"type": "integer", "minimum": 0}
    }},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {"type": "object", "required": ["canonical_owner", "representation_owner", "runtime_consumer", "consumer_can_write_authoritative_world_state", "consumer_can_commit", "rncs_authority_required"], "additionalProperties": false, "properties": {
      "canonical_owner": {"const": "RNCS"},
      "representation_owner": {"const": "URRF"},
      "runtime_consumer": {"const": "VSR/RSR_ADAPTER"},
      "consumer_can_write_authoritative_world_state": {"const": false},
      "consumer_can_commit": {"const": false},
      "rncs_authority_required": {"const": true}
    }},
    "report_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableRoot": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "nullableText": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "kind": {"enum": ["mesh", "sdf", "voxel", "point-cloud", "gaussian-splat", "neural-field", "curve", "particle", "material", "rig", "animation"]},
    "entry": {"type": "object", "required": [
      "component_id",
      "representation_id",
      "representation_root",
      "representation_kind",
      "representation_profile",
      "source_content_root",
      "handler_id",
      "resource_ids",
      "status",
      "reason",
      "verification_status",
      "loaded_resource_count",
      "loaded_byte_length",
      "receipt_root",
      "output_root",
      "metrics",
      "candidate_only",
      "authoritative",
      "entry_root"
    ], "additionalProperties": false, "properties": {
      "component_id": {"type": "string", "minLength": 1},
      "representation_id": {"$ref": "#/$defs/nullableText"},
      "representation_root": {"$ref": "#/$defs/nullableRoot"},
      "representation_kind": {"$ref": "#/$defs/kind"},
      "representation_profile": {"type": "string", "minLength": 1},
      "source_content_root": {"$ref": "#/$defs/root"},
      "handler_id": {"$ref": "#/$defs/nullableText"},
      "resource_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "status": {"enum": ["EXECUTED", "BLOCKED", "FAILED", "NOT_RUN"]},
      "reason": {"$ref": "#/$defs/nullableText"},
      "verification_status": {"enum": ["HANDLER_VERIFIED", "FAILED", "NOT_APPLICABLE", "NOT_RUN"]},
      "loaded_resource_count": {"type": "integer", "minimum": 0},
      "loaded_byte_length": {"type": "integer", "minimum": 0},
      "receipt_root": {"$ref": "#/$defs/nullableRoot"},
      "output_root": {"$ref": "#/$defs/nullableRoot"},
      "metrics": {"type": "object", "additionalProperties": true},
      "candidate_only": {"const": true},
      "authoritative": {"const": false},
      "entry_root": {"$ref": "#/$defs/root"}
    }}
  },
  "additionalProperties": false
}
