{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/rncs.large-world-stream-transition.v0.1.schema.json",
  "title": "RNCS Large World Stream Transition v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "world_id",
    "generation",
    "region_root",
    "world_root",
    "previous_stream_root",
    "previous_active_chunk_ids",
    "next_active_chunk_ids",
    "entered_chunk_ids",
    "retained_chunk_ids",
    "exited_chunk_ids",
    "released_chunk_ids",
    "evicted_chunk_ids",
    "loaded_chunk_ids",
    "load_radius",
    "unload_radius",
    "canonical_state_mutated",
    "authority",
    "candidate_only",
    "authoritative",
    "commit_status",
    "transition_root"
  ],
  "properties": {
    "format": {"const": "rncs.large-world-stream-transition.v0.1"},
    "version": {"const": "0.1.0"},
    "world_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "region_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "world_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_stream_root": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "previous_active_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_active_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "entered_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "retained_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exited_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "released_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evicted_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "loaded_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "load_radius": {"type": "integer", "minimum": 0},
    "unload_radius": {"type": "integer", "minimum": 0},
    "canonical_state_mutated": {"const": false},
    "authority": {"type": "object"},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "commit_status": {"const": "NOT_COMMITTED"},
    "transition_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
