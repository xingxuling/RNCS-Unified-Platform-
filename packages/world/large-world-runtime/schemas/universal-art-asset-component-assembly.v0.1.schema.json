{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-component-assembly.v0.1.schema.json",
  "title": "URRF Universal Art Asset Component Assembly v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "assembly_id",
    "source",
    "component_graph_root",
    "component_execution_root",
    "execution_status",
    "source_reality_root",
    "scene_id",
    "world_id",
    "root_transform",
    "component_count",
    "components",
    "resource_count",
    "resources",
    "resource_index",
    "summary",
    "checks",
    "file_verification",
    "status",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "aaa_ready",
    "release_ready",
    "authority",
    "component_assembly_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-component-assembly.v0.1"},
    "version": {"const": "0.1.0"},
    "assembly_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {"const": "urrf-component-graph-assembly"},
    "component_graph_root": {"$ref": "#/$defs/root"},
    "component_execution_root": {"$ref": "#/$defs/root"},
    "execution_status": {"enum": ["CANDIDATE_COMPONENT_GRAPH_EXECUTED", "CANDIDATE_COMPONENT_GRAPH_FAILED", "CANDIDATE_COMPONENT_GRAPH_BLOCKED", "CANDIDATE_COMPONENT_GRAPH_NOT_RUN"]},
    "source_reality_root": {"$ref": "#/$defs/nullableRoot"},
    "scene_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "root_transform": {"$ref": "#/$defs/transform"},
    "component_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "components": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/component"}},
    "resource_count": {"type": "integer", "minimum": 0, "maximum": 16384},
    "resources": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/resource"}},
    "resource_index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["component_id", "stage_id", "role", "path", "byte_length", "sha256", "resource_root"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "stage_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "byte_length": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/root"},
          "resource_root": {"$ref": "#/$defs/root"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["component_count", "completed_count", "failed_count", "blocked_count", "not_run_count", "resource_count", "bound_component_count", "missing_resource_component_count"],
      "properties": {
        "component_count": {"type": "integer", "minimum": 1, "maximum": 128},
        "completed_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "failed_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "blocked_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "not_run_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "resource_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "bound_component_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "missing_resource_component_count": {"type": "integer", "minimum": 0, "maximum": 128}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["graph_binding", "execution_binding", "component_order", "dependency_binding", "artifact_binding", "resource_binding", "resource_path_safety", "resource_file_integrity", "transform_integrity", "authority_boundary"],
      "properties": {
        "graph_binding": {"type": "boolean"},
        "execution_binding": {"type": "boolean"},
        "component_order": {"type": "boolean"},
        "dependency_binding": {"type": "boolean"},
        "artifact_binding": {"type": "boolean"},
        "resource_binding": {"type": "boolean"},
        "resource_path_safety": {"type": "boolean"},
        "resource_file_integrity": {"type": "boolean"},
        "transform_integrity": {"type": "boolean"},
        "authority_boundary": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "file_verification": {
      "type": "object",
      "required": ["mode", "checked_count", "passed_count", "failed_count", "failures"],
      "properties": {
        "mode": {"enum": ["LOCAL_BYTES", "NOT_RUN"]},
        "checked_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "passed_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "failed_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "failures": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "object",
            "required": ["resource_id", "code", "detail"],
            "properties": {
              "resource_id": {"type": "string", "minLength": 1},
              "code": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "status": {"enum": ["CANDIDATE_COMPONENT_ASSEMBLY_READY", "CANDIDATE_COMPONENT_ASSEMBLY_BLOCKED"]},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "aaa_ready": {"const": false},
    "release_ready": {"const": false},
    "authority": {
      "type": "object",
      "required": ["canonical_owner", "representation_owner", "provider_can_write_authoritative_world_state", "provider_can_commit", "composition_can_commit", "rncs_authority_required"],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "composition_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "component_assembly_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableRoot": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
    "nullableText": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "profile": {"enum": ["character", "creature", "prop", "vehicle", "structure", "environment", "vegetation", "resource", "vfx"]},
    "qualityTier": {"enum": ["PREVIEW", "PRODUCTION", "AAA"]},
    "representationKind": {"enum": ["mesh", "sdf", "voxel", "point-cloud", "gaussian-splat", "neural-field", "curve", "particle", "material", "rig", "animation"]},
    "vector": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "required": ["translation_mm", "rotation_deg", "scale_milli"],
      "properties": {
        "translation_mm": {"$ref": "#/$defs/vector"},
        "rotation_deg": {"$ref": "#/$defs/vector"},
        "scale_milli": {"$ref": "#/$defs/positiveVector"}
      },
      "additionalProperties": false
    },
    "dependencyBinding": {
      "type": "object",
      "required": ["component_id", "status", "execution_root", "output_root", "result_root"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETED", "FAILED", "BLOCKED", "NOT_RUN"]},
        "execution_root": {"$ref": "#/$defs/nullableRoot"},
        "output_root": {"$ref": "#/$defs/nullableRoot"},
        "result_root": {"$ref": "#/$defs/nullableRoot"}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["index", "component_id", "role", "asset_id", "asset_profile", "quality_tier", "genome_root", "parent_component_id", "depends_on", "dependency_bindings", "representation", "transform", "pipeline_status", "status", "failure_code", "artifact_root", "execution_root", "output_root", "result_root", "resource_status", "resource_count", "resource_ids", "graph_root", "candidate_only", "authoritative", "canonical_write_authorized", "component_root"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 127},
        "component_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 96},
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "asset_profile": {"$ref": "#/$defs/profile"},
        "quality_tier": {"$ref": "#/$defs/qualityTier"},
        "genome_root": {"$ref": "#/$defs/root"},
        "parent_component_id": {"$ref": "#/$defs/nullableText"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependency_bindings": {"type": "array", "items": {"$ref": "#/$defs/dependencyBinding"}},
        "representation": {
          "type": "object",
          "required": ["kind", "profile", "source_root", "candidate_only", "authoritative"],
          "properties": {
            "kind": {"$ref": "#/$defs/representationKind"},
            "profile": {"type": "string", "minLength": 1, "maxLength": 96},
            "source_root": {"$ref": "#/$defs/nullableRoot"},
            "candidate_only": {"const": true},
            "authoritative": {"const": false}
          },
          "additionalProperties": false
        },
        "transform": {"$ref": "#/$defs/transform"},
        "pipeline_status": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETED", "FAILED", "BLOCKED", "NOT_RUN"]},
        "failure_code": {"$ref": "#/$defs/nullableText"},
        "artifact_root": {"$ref": "#/$defs/nullableRoot"},
        "execution_root": {"$ref": "#/$defs/nullableRoot"},
        "output_root": {"$ref": "#/$defs/nullableRoot"},
        "result_root": {"$ref": "#/$defs/nullableRoot"},
        "resource_status": {"enum": ["BOUND", "MISSING", "NOT_RUN"]},
        "resource_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "resource_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "graph_root": {"$ref": "#/$defs/root"},
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "canonical_write_authorized": {"const": false},
        "component_root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["resource_id", "component_id", "stage_id", "role", "representation_kind", "format", "path", "output_directory", "byte_length", "sha256", "declared_sha256", "artifact_root", "output_root", "result_root", "candidate_only", "authoritative", "resource_root"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "representation_kind": {"$ref": "#/$defs/representationKind"},
        "format": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:).+$"},
        "output_directory": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/root"},
        "declared_sha256": {"$ref": "#/$defs/nullableRoot"},
        "artifact_root": {"$ref": "#/$defs/root"},
        "output_root": {"$ref": "#/$defs/root"},
        "result_root": {"$ref": "#/$defs/nullableRoot"},
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "resource_root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
