{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-file-inspection.v0.1.schema.json",
  "title": "URRF Universal Art Asset File Inspection v0.1",
  "type": "object",
  "required": ["format", "version", "source", "method", "status", "files", "aggregates", "errors", "inspection_root"],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-file-inspection.v0.1"},
    "version": {"const": "0.1.0"},
    "source": {"const": "local-glb-inspector"},
    "method": {"const": "urrf.glb-structural-inspector.v0.1"},
    "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists", "glb_valid", "errors", "geometry", "topology", "uv", "normals"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": ["string", "null"]},
          "lod": {"type": ["integer", "null"], "minimum": 0},
          "exists": {"type": "boolean"},
          "glb_valid": {"type": "boolean"},
          "valid": {"type": "boolean"},
          "errors": {"type": "array", "items": {"type": "string"}},
          "geometry": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL"]}}, "additionalProperties": true},
          "topology": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL"]}}, "additionalProperties": true},
          "uv": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL"]}}, "additionalProperties": true},
          "normals": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL"]}}, "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "aggregates": {
      "type": "object",
      "required": ["geometry_status", "topology_status", "uv_status", "normal_status", "triangle_count", "vertex_count", "file_count", "valid_file_count"],
      "properties": {
        "geometry_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "topology_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "uv_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "normal_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "triangle_count": {"type": "integer", "minimum": 0},
        "vertex_count": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "valid_file_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "inspection_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
