{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-batch.v0.1.schema.json",
  "title": "URRF Universal Art Asset Batch v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "batch_id",
    "output_directory",
    "asset_count",
    "assets",
    "summary",
    "artifact_root_index",
    "status",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "batch_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-batch.v0.1"},
    "version": {"const": "0.1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["asset_key", "index", "output_directory", "asset_id", "asset_profile", "quality_tier", "status", "acceptance_pass", "genome_root", "candidate_root", "acceptance_root", "forge_root", "artifact_roots", "failures"],
        "properties": {
          "asset_key": {"type": "string", "minLength": 1},
          "index": {"type": "integer", "minimum": 0},
          "output_directory": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "asset_profile": {"enum": ["character", "creature", "prop", "vehicle", "structure", "environment", "vegetation", "resource", "vfx"]},
          "quality_tier": {"enum": ["PREVIEW", "PRODUCTION", "AAA"]},
          "status": {"enum": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"]},
          "acceptance_pass": {"type": "boolean"},
          "genome_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "candidate_root": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "acceptance_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "forge_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact_roots": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "failures": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["asset_count", "ready_count", "blocked_count", "acceptance_pass_count", "all_acceptance_pass", "unique_artifact_root_count"],
      "properties": {
        "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "ready_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0},
        "acceptance_pass_count": {"type": "integer", "minimum": 0},
        "all_acceptance_pass": {"type": "boolean"},
        "unique_artifact_root_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "artifact_root_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["asset_key", "role"],
          "properties": {
            "asset_key": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "status": {"enum": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"]},
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {
      "type": "object",
      "required": ["canonical_owner", "representation_owner", "provider_can_write_authoritative_world_state", "provider_can_commit", "acceptance_can_commit", "rncs_authority_required"],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "acceptance_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"},
    "batch_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
