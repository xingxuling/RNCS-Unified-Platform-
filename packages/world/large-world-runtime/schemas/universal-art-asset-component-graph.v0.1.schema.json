{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-component-graph.v0.1.schema.json",
  "title": "URRF Universal Art Asset Component Graph v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "composition_id",
    "name",
    "description",
    "asset_id",
    "asset_profile",
    "quality_tier",
    "genome_root",
    "source_reality_root",
    "component_count",
    "dependency_edge_count",
    "components",
    "dependency_edges",
    "topological_order",
    "axes",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "component_graph_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-component-graph.v0.1"},
    "version": {"const": "0.1.0"},
    "composition_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 4096},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "asset_profile": {"$ref": "#/$defs/profile"},
    "quality_tier": {"$ref": "#/$defs/qualityTier"},
    "genome_root": {"$ref": "#/$defs/root"},
    "source_reality_root": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/root"}]},
    "component_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "dependency_edge_count": {"type": "integer", "minimum": 0, "maximum": 16384},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/component"}
    },
    "dependency_edges": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"$ref": "#/$defs/componentId"},
          "to": {"$ref": "#/$defs/componentId"}
        },
        "additionalProperties": false
      }
    },
    "topological_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/componentId"}
    },
    "axes": {
      "type": "object",
      "required": ["component_profiles", "representation_kinds", "dependency_mode"],
      "properties": {
        "component_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}},
        "representation_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/representationKind"}},
        "dependency_mode": {"enum": ["directed-acyclic-graph", "independent-components"]}
      },
      "additionalProperties": false
    },
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {
      "type": "object",
      "required": [
        "canonical_owner",
        "representation_owner",
        "provider_can_write_authoritative_world_state",
        "provider_can_commit",
        "composition_can_commit",
        "rncs_authority_required"
      ],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "composition_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "component_graph_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "componentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"},
    "profile": {"enum": ["character", "creature", "prop", "vehicle", "structure", "environment", "vegetation", "resource", "vfx"]},
    "qualityTier": {"enum": ["PREVIEW", "PRODUCTION", "AAA"]},
    "representationKind": {"enum": ["mesh", "sdf", "voxel", "point-cloud", "gaussian-splat", "neural-field", "curve", "particle", "material", "rig", "animation"]},
    "vector": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 3,
      "maxItems": 3
    },
    "component": {
      "type": "object",
      "required": [
        "component_id",
        "role",
        "asset_id",
        "asset_profile",
        "quality_tier",
        "genome_root",
        "representation",
        "parent_component_id",
        "depends_on",
        "transform_mm",
        "rotation_deg",
        "scale_milli",
        "variant",
        "provider_id",
        "candidate_only",
        "authoritative",
        "canonical_write_authorized"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/componentId"},
        "role": {"type": "string", "minLength": 1, "maxLength": 96},
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "asset_profile": {"$ref": "#/$defs/profile"},
        "quality_tier": {"$ref": "#/$defs/qualityTier"},
        "genome_root": {"$ref": "#/$defs/root"},
        "representation": {
          "type": "object",
          "required": ["kind", "profile", "source_root", "candidate_only", "authoritative"],
          "properties": {
            "kind": {"$ref": "#/$defs/representationKind"},
            "profile": {"type": "string", "minLength": 1, "maxLength": 96},
            "source_root": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/root"}]},
            "candidate_only": {"const": true},
            "authoritative": {"const": false}
          },
          "additionalProperties": false
        },
        "parent_component_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/componentId"}]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
        "transform_mm": {"$ref": "#/$defs/vector"},
        "rotation_deg": {"$ref": "#/$defs/vector"},
        "scale_milli": {"$ref": "#/$defs/positiveVector"},
        "variant": {"type": "integer", "minimum": 0, "maximum": 255},
        "provider_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
        "candidate_only": {"const": true},
        "authoritative": {"const": false},
        "canonical_write_authorized": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
