{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.org/schemas/urrf.universal-art-asset-assembly.v0.1.schema.json",
  "title": "URRF Universal Art Asset Candidate Assembly v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "assembly_id",
    "batch_root",
    "source_reality_root",
    "scene_id",
    "world_id",
    "placement_root",
    "asset_count",
    "status",
    "lod_policy",
    "streaming",
    "assets",
    "artifact_root_index",
    "summary",
    "candidate_only",
    "authoritative",
    "canonical_write_authorized",
    "authority",
    "assembly_root"
  ],
  "properties": {
    "format": {"const": "urrf.universal-art-asset-assembly.v0.1"},
    "version": {"const": "0.1.0"},
    "assembly_id": {"type": "string", "minLength": 1},
    "batch_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_reality_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scene_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "placement_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "status": {"enum": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"]},
    "lod_policy": {
      "type": "object",
      "required": ["selection_mode", "default_lod", "max_lod"],
      "properties": {
        "selection_mode": {"const": "preselected-local-inspection"},
        "default_lod": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_lod": {"type": "integer", "minimum": 0, "maximum": 32}
      },
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "required": ["load_radius", "unload_radius"],
      "properties": {
        "load_radius": {"type": "number", "minimum": 0},
        "unload_radius": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "asset_key",
          "index",
          "asset_id",
          "asset_profile",
          "quality_tier",
          "status",
          "acceptance_pass",
          "genome_root",
          "candidate_root",
          "acceptance_root",
          "forge_root",
          "selected_lod",
          "placement_mm",
          "cell_id",
          "priority",
          "failures",
          "source",
          "asset_root"
        ],
        "properties": {
          "asset_key": {"type": "string", "minLength": 1},
          "index": {"type": "integer", "minimum": 0},
          "asset_id": {"type": "string", "minLength": 1},
          "asset_profile": {"enum": ["character", "creature", "prop", "vehicle", "structure", "environment", "vegetation", "resource", "vfx"]},
          "quality_tier": {"enum": ["PREVIEW", "PRODUCTION", "AAA"]},
          "status": {"enum": ["BLOCKED", "READY_FOR_HUMAN_REVIEW"]},
          "acceptance_pass": {"type": "boolean"},
          "genome_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "candidate_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "acceptance_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "forge_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "selected_lod": {"type": "integer", "minimum": 0, "maximum": 32},
          "placement_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": -1000000, "maximum": 1000000}},
          "cell_id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "failures": {"type": "array", "items": {"type": "string"}},
          "source": {
            "type": "object",
            "required": ["output_directory", "mesh", "pbr"],
            "properties": {
              "output_directory": {"type": "string", "minLength": 1},
              "mesh": {
                "type": "object",
                "required": ["role", "relative_path", "format", "file_root", "sha256", "byte_length", "candidate_artifact_root", "candidate_file_root"],
                "properties": {
                  "role": {"type": "string", "minLength": 1},
                  "relative_path": {"type": "string", "minLength": 1},
                  "format": {"const": "model/gltf-binary"},
                  "file_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "byte_length": {"type": "integer", "minimum": 1},
                  "candidate_artifact_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "candidate_file_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                },
                "additionalProperties": false
              },
              "pbr": {
                "type": "object",
                "required": ["pack_root", "texture_count", "channels"],
                "properties": {
                  "pack_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "texture_count": {"type": "integer", "minimum": 4},
                  "channels": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "object",
                      "required": ["role", "relative_path", "file_root", "sha256", "byte_length", "mime"],
                      "properties": {
                        "role": {"type": "string", "minLength": 1},
                        "relative_path": {"type": "string", "minLength": 1},
                        "file_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                        "byte_length": {"type": "integer", "minimum": 1},
                        "mime": {"type": "string", "minLength": 1}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "asset_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "artifact_root_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["asset_key", "role"],
          "properties": {
            "asset_key": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["asset_count", "blocked_count", "ready_count", "acceptance_pass_count", "selected_lod_histogram"],
      "properties": {
        "asset_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "blocked_count": {"type": "integer", "minimum": 0},
        "ready_count": {"type": "integer", "minimum": 0},
        "acceptance_pass_count": {"type": "integer", "minimum": 0},
        "selected_lod_histogram": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "candidate_only": {"const": true},
    "authoritative": {"const": false},
    "canonical_write_authorized": {"const": false},
    "authority": {
      "type": "object",
      "required": ["canonical_owner", "representation_owner", "provider_can_write_authoritative_world_state", "provider_can_commit", "acceptance_can_commit", "rncs_authority_required"],
      "properties": {
        "canonical_owner": {"const": "RNCS"},
        "representation_owner": {"const": "URRF"},
        "provider_can_write_authoritative_world_state": {"const": false},
        "provider_can_commit": {"const": false},
        "acceptance_can_commit": {"const": false},
        "rncs_authority_required": {"const": true}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"},
    "assembly_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
