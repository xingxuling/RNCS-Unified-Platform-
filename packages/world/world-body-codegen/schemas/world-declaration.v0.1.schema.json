{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/world-declaration.v0.1.schema.json",
  "title": "World Body Declaration v0.1",
  "type": "object",
  "required": ["format", "declarationVersion", "world", "entities"],
  "properties": {
    "format": { "const": "taowind.world-declaration.v0.1" },
    "declarationVersion": { "const": "0.1.0-alpha.1" },
    "world": {
      "type": "object",
      "required": ["id", "generation", "revision", "tick", "tickHz", "authorityClass", "authorityOwner", "sourceRealityRoot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": 0 },
        "tickHz": { "type": "integer", "minimum": 1 },
        "authorityClass": { "enum": ["candidate", "authoritative-snapshot", "committed-generation"] },
        "authorityOwner": { "type": "string" },
        "sourceRealityRoot": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "capabilityScopes": { "type": "array", "items": { "type": "string" } },
        "gravityMmPerSecondSquared": { "$ref": "#/$defs/vector3" },
        "floorY": { "type": "integer" },
        "solver": { "type": "object" }
      },
      "additionalProperties": true
    },
    "assets": { "type": "array", "items": { "type": "object" } },
    "observers": { "type": "array", "items": { "type": "object" } },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "visual", "temporal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "authorityMode": { "enum": ["authoritative", "presentation-only"] },
          "physical": { "type": "object" },
          "visual": { "type": "object" },
          "temporal": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "events": { "type": "array", "items": { "type": "object" } },
    "renderGraphs": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "z": { "type": "integer" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
