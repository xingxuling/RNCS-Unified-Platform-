{
  "specVersion":"0.1","metadata":{"id":"interactive-card","title":"Interactive Card","duration":20,"defaultFps":60,"seed":99},
  "canvas":{"width":800,"height":600,"layoutMode":"responsive","background":{"type":"solid","color":"#111827"}},
  "variables":{"active":false,"title":"AGENT-NATIVE CARD"},
