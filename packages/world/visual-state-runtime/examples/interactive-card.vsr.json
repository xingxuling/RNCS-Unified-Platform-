    {"id":"card-title","type":"text","layout":{"x":"50%","y":"46%","width":400,"height":60,"anchorX":0.5,"anchorY":0.5},"appearance":{"fill":{"type":"solid","color":"#f5f9ff"}},"content":{"text":{"binding":"vars.title"},"fontSize":32,"fontWeight":"bold","align":"center"}},
    {"id":"hint","type":"text","layout":{"x":"50%","y":"59%","width":360,"height":40,"anchorX":0.5,"anchorY":0.5},"appearance":{"fill":{"type":"solid","color":"#8bbcff"}},"content":{"text":"MOVE THE POINTER","fontSize":18,"align":"center"}}
  ],
