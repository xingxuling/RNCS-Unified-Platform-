{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.company/schemas/vsr-spatial-scene-composition-receipt.v0.1.schema.json",
  "title": "VSR Spatial Scene Composition Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "sceneId",
    "worldId",
    "fragmentIds",
    "fragmentCount",
    "sourceSceneRoots",
    "sceneRoot",
    "candidateOnly",
    "authoritative",
    "receiptRoot"
  ],
  "properties": {
    "format": {"const": "vsr.spatial-scene-composition-receipt.v0.1"},
    "version": {"const": "0.1.0"},
    "sceneId": {"type": "string", "minLength": 1, "maxLength": 256},
    "worldId": {"type": "string", "minLength": 1, "maxLength": 256},
    "fragmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "fragmentCount": {"type": "integer", "minimum": 1, "maximum": 1024},
    "sourceSceneRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "sceneRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidateOnly": {"const": true},
    "authoritative": {"const": false},
    "receiptRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
