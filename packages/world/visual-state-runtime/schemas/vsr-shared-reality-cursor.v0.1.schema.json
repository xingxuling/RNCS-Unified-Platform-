{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/vsr-shared-reality-cursor.v0.1.schema.json",
  "title": "VSR Shared Reality Cursor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sessionId",
    "sequence",
    "eventRoot"
  ],
  "properties": {
    "format": {
      "const": "vsr.shared-reality-cursor.v0.1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "eventRoot": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    }
  }
}
