{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/vsr-pbr-material-import-receipt.v0.1.schema.json",
  "title": "VSR PBR Material Import Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "componentId", "sceneId", "assetId", "representationKind", "profileId", "materialModel", "variant", "channelRoles", "channelAssetIds", "channelByteLengths", "channelByteRoots", "channelColorSpaces", "resourceRoot", "candidateRoot", "channelCount", "byteLength", "candidateOnly", "authoritative", "receiptRoot"],
  "properties": {
    "format": {"const": "vsr.pbr-material-import-receipt.v0.1"},
    "version": {"const": "0.1.0"},
    "componentId": {"type": "string", "minLength": 1, "maxLength": 256},
    "sceneId": {"type": "string", "minLength": 1, "maxLength": 256},
    "assetId": {"type": "string", "minLength": 1, "maxLength": 256},
    "representationKind": {"const": "material"},
    "profileId": {"type": "string", "minLength": 1, "maxLength": 256},
    "materialModel": {"type": "string", "minLength": 1, "maxLength": 256},
    "variant": {"type": "string", "minLength": 1, "maxLength": 256},
    "channelRoles": {"type": "array", "const": ["base-color", "normal", "occlusion-roughness-metallic", "emissive"]},
    "channelAssetIds": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "sourceChannelAssetIds": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "channelByteLengths": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 1}},
    "channelByteRoots": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "channelColorSpaces": {"type": "array", "const": ["srgb", "linear", "linear", "srgb"]},
    "metadataAssetId": {"type": "string", "minLength": 1, "maxLength": 256},
    "metadataRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resourceRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidateRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "channelCount": {"const": 4},
    "byteLength": {"type": "integer", "minimum": 4},
    "candidateOnly": {"const": true},
    "authoritative": {"const": false},
    "receiptRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
