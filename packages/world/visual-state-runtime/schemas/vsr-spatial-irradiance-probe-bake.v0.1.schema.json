{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-irradiance-probe-bake.v0.1.schema.json",
  "title": "VSR Spatial Irradiance Probe Bake v0.1",
  "type": "object",
  "required": ["format", "version", "sceneId", "sourceRoot", "settings", "probes", "root"],
  "properties": {
    "format": {"const": "vsr.spatial-irradiance-probe-bake.v0.1"},
    "version": {"const": "0.1.0"},
    "sceneId": {"type": "string", "minLength": 1},
    "sourceRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "settings": {
      "type": "object",
      "required": ["count", "radius", "positions", "idPrefix"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 8},
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
        },
        "idPrefix": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "position", "radius", "diffuseColor", "specularColor", "intensity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "radius": {"type": "number", "exclusiveMinimum": 0},
          "diffuseColor": {"type": "string"},
          "specularColor": {"type": "string"},
          "intensity": {"type": "number", "minimum": 0, "maximum": 32}
        },
        "additionalProperties": false
      }
    },
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
