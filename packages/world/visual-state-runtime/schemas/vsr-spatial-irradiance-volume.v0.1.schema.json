{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/vsr-spatial-irradiance-volume.v0.1.schema.json",
  "title": "VSR Spatial Irradiance Volume v0.1",
  "type": "object",
  "required": [
    "format",
    "version",
    "sceneId",
    "sourceRoot",
    "topologyRoot",
    "settings",
    "samples",
    "root"
  ],
  "properties": {
    "format": {
      "const": "vsr.spatial-irradiance-volume.v0.1"
    },
    "version": {
      "const": "0.1.0"
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topologyRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settings": {
      "type": "object",
      "required": [
        "boundsMin",
        "boundsMax",
        "dimensions",
        "blendWeight",
        "updateAlpha",
        "visibilitySamples",
        "shadowBias"
      ],
      "properties": {
        "boundsMin": {
          "$ref": "#/$defs/vec3"
        },
        "boundsMax": {
          "$ref": "#/$defs/vec3"
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 16
          }
        },
        "blendWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "updateAlpha": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "visibilitySamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "shadowBias": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "diffuseColor",
          "specularColor",
          "intensity",
          "visibility"
        ],
        "properties": {
          "diffuseColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "specularColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 64
          },
          "visibility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
