{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-lightmap-bake.v0.1.schema.json",
  "title": "VSR Spatial Lightmap Bake v0.1",
  "type": "object",
  "required": ["format", "version", "sceneId", "sourceRoot", "settings", "texture", "meshes", "materials", "charts", "root"],
  "properties": {
    "format": {"const": "vsr.spatial-lightmap-bake.v0.1"},
    "version": {"const": "0.1.0"},
    "sceneId": {"type": "string", "minLength": 1},
    "sourceRoot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "settings": {
      "type": "object",
      "required": ["width", "height", "padding", "maxTriangles", "ambientIntensity", "radianceScale"],
      "properties": {
        "width": {"type": "integer", "minimum": 32, "maximum": 2048},
        "height": {"type": "integer", "minimum": 32, "maximum": 2048},
        "padding": {"type": "integer", "minimum": 0, "maximum": 32},
        "maxTriangles": {"type": "integer", "minimum": 1, "maximum": 65536},
        "ambientIntensity": {"type": "number", "minimum": 0, "maximum": 8},
        "radianceScale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "texture": {
      "type": "object",
      "required": ["id", "width", "height", "pixels"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "pixels": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "colorSpace": {"const": "linear"},
        "wrapU": {"const": "clamp"},
        "wrapV": {"const": "clamp"},
        "filter": {"const": "linear"}
      },
      "additionalProperties": false
    },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "positions", "uvs1", "indices"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "positions": {"type": "array", "minItems": 9, "items": {"type": "number"}},
          "normals": {"type": "array", "items": {"type": "number"}},
          "uvs": {"type": "array", "items": {"type": "number"}},
          "uvs1": {"type": "array", "items": {"type": "number"}},
          "indices": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}},
          "topology": {"const": "triangle-list"}
        },
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["id", "lightmapTextureId", "lightmapIntensity", "lightmapUvSet"], "properties": {"id": {"type": "string", "minLength": 1}, "lightmapTextureId": {"type": "string", "minLength": 1}, "lightmapIntensity": {"type": "number", "minimum": 0, "maximum": 8}, "lightmapUvSet": {"const": 1}}, "additionalProperties": true}
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeId", "sourceMeshId", "bakedMeshId", "sourceMaterialId", "bakedMaterialId", "triangleCount"],
        "properties": {"nodeId": {"type": "string", "minLength": 1}, "sourceMeshId": {"type": "string", "minLength": 1}, "bakedMeshId": {"type": "string", "minLength": 1}, "sourceMaterialId": {"type": "string", "minLength": 1}, "bakedMaterialId": {"type": "string", "minLength": 1}, "triangleCount": {"type": "integer", "minimum": 1}},
        "additionalProperties": false
      }
    },
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
