{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-frame-plan.v0.4.schema.json",
  "title": "VSR Spatial Frame Plan v0.4",
  "type": "object",
  "required": [
    "format",
    "version",
    "sceneId",
    "viewport",
    "budget",
    "camera",
    "drawPackets",
    "lights",
    "passes",
    "resources",
    "stats",
    "sourceRealityRoot",
    "geometryRoot",
    "materialRoot",
    "textureRoot",
    "animationRoot",
    "commandRoot",
    "frameRoot"
  ],
  "properties": {
    "format": {
      "const": "vsr.spatial-frame-plan.v0.4"
    },
    "version": {
      "type": "string"
    },
    "sceneId": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "type": "object"
    },
    "camera": {
      "type": "object"
    },
    "environment": {
      "type": "object",
      "required": [
        "diffuseColor",
        "specularColor",
        "intensity"
      ],
      "properties": {
        "diffuseColor": {
          "type": "string"
        },
        "specularColor": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "textureId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "required": [
        "format",
        "worldId",
        "observerPosition",
        "activeCellIds",
        "enteredCellIds",
        "exitedCellIds",
        "nodeIds",
        "catalogRoot",
        "root"
      ],
      "properties": {
        "format": {
          "const": "vsr.spatial-streaming-resolution.v0.1"
        },
        "worldId": {
          "type": "string"
        },
        "observerPosition": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "loadRadius": {
          "type": "number",
          "minimum": 0
        },
        "unloadRadius": {
          "type": "number",
          "minimum": 0
        },
        "previousActiveCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forcedCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enteredCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exitedCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistentNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalogRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "gpuDrivenCulling": {
      "type": "boolean"
    },
    "drawPackets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "meshId",
          "materialId",
          "textureBindings",
          "packetRoot"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "meshId": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "textureBindings": {
            "type": "object",
            "properties": {
              "baseColor": {
                "type": "string"
              },
              "metallicRoughness": {
                "type": "string"
              },
              "normal": {
                "type": "string"
              },
              "occlusion": {
                "type": "string"
              },
              "emissive": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "worldMatrix",
                "worldBounds",
                "distanceToCamera"
              ],
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "worldMatrix": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": {
                    "type": "number"
                  }
                },
                "worldBounds": {
                  "type": "object"
                },
                "distanceToCamera": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "instanceCount": {
            "type": "integer",
            "minimum": 1
          },
          "packetRoot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "lights": {
      "type": "array"
    },
    "passes": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "shaders": {
      "type": "object"
    },
    "stats": {
      "type": "object",
      "required": [
        "textureCount",
        "materialTextureBindings"
      ],
      "properties": {
        "textureCount": {
          "type": "integer",
          "minimum": 0
        },
        "materialTextureBindings": {
          "type": "integer",
          "minimum": 0
        },
        "visibleInstances": {
          "type": "integer",
          "minimum": 0
        },
        "instancedDraws": {
          "type": "integer",
          "minimum": 0
        },
        "activeCells": {
          "type": "integer",
          "minimum": 0
        },
        "streamedNodes": {
          "type": "integer",
          "minimum": 0
        },
        "streamingCulledCells": {
          "type": "integer",
          "minimum": 0
        },
        "gpuDrivenDraws": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRealityRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometryRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commandRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frameRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "textureRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "animationRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
