{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-frame-plan.v0.4.schema.json",
  "title": "VSR Spatial Frame Plan v0.4",
  "type": "object",
  "required": [
    "format",
    "version",
    "sceneId",
    "viewport",
    "budget",
    "camera",
    "transparencyMode",
    "drawPackets",
    "lights",
    "passes",
    "resources",
    "stats",
    "sourceRealityRoot",
    "geometryRoot",
    "materialRoot",
    "textureRoot",
    "animationRoot",
    "temporalRoot",
    "commandRoot",
    "frameRoot"
  ],
  "properties": {
    "format": {
      "const": "vsr.spatial-frame-plan.v0.4"
    },
    "version": {
      "type": "string"
    },
    "sceneId": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "gpuTextureBudgetBytes": {
          "type": "integer",
          "minimum": 4
        },
        "gpuBufferBudgetBytes": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "camera": {
      "type": "object"
    },
    "environment": {
      "type": "object",
      "required": [
        "diffuseColor",
        "specularColor",
        "intensity"
      ],
      "properties": {
        "diffuseColor": {
          "type": "string"
        },
        "specularColor": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "textureId": {
          "type": "string",
          "minLength": 1
        },
        "irradianceBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lightmapBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolumeBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolume": {
          "$ref": "vsr-spatial-irradiance-volume.v0.1.schema.json"
        },
        "irradianceVolumeFieldRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolumeField": {
          "$ref": "vsr-spatial-irradiance-volume-field.v0.1.schema.json"
        },
        "probes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "position",
              "radius",
              "diffuseColor",
              "specularColor",
              "intensity"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "diffuseColor": {
                "type": "string"
              },
              "specularColor": {
                "type": "string"
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 32
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "postProcess": {
      "type": "object",
      "required": [
        "exposure",
        "contrast",
        "saturation",
        "vignette"
      ],
      "properties": {
        "exposure": {
          "type": "number",
          "minimum": -8,
          "maximum": 8
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bloomThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "bloomIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "bloomRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "dofFocus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dofRange": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "dofIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dofRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "temporalBlend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporalReset": {
          "type": "boolean"
        },
        "temporalClamp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporalReactive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporalReactiveThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "temporalVelocityThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "temporalVelocityDilation": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "ssaoIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ssaoRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "ssgiIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "ssgiRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "ssgiSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "ssgiThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        }
      },
      "additionalProperties": false
    },
    "transparencyMode": {
      "enum": [
        "weighted-blended-oit",
        "sorted"
      ]
    },
    "streaming": {
      "type": "object",
      "required": [
        "format",
        "worldId",
        "observerPosition",
        "activeCellIds",
        "enteredCellIds",
        "exitedCellIds",
        "nodeIds",
        "catalogRoot",
        "root"
      ],
      "properties": {
        "format": {
          "const": "vsr.spatial-streaming-resolution.v0.1"
        },
        "worldId": {
          "type": "string"
        },
        "observerPosition": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "loadRadius": {
          "type": "number",
          "minimum": 0
        },
        "unloadRadius": {
          "type": "number",
          "minimum": 0
        },
        "previousActiveCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forcedCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enteredCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exitedCellIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistentNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalogRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "hlod": {
      "type": "object",
      "required": [
        "format",
        "clusters",
        "root"
      ],
      "properties": {
        "format": {
          "const": "vsr.spatial-hlod-resolution.v0.1"
        },
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "distanceToCamera",
              "selectedLevel",
              "selectedNodeIds",
              "suppressedNodeIds",
              "proxyAvailable"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "distanceToCamera": {
                "type": "number",
                "minimum": 0
              },
              "selectedLevel": {
                "oneOf": [
                  {
                    "const": "source"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "selectedNodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "suppressedNodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "proxyAvailable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "gpuDrivenCulling": {
      "type": "boolean"
    },
    "assetStreaming": {
      "$ref": "./vsr-spatial-asset-streaming.v0.1.schema.json"
    },
    "drawPackets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "meshId",
          "materialId",
          "textureBindings",
          "packetRoot"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "meshId": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "textureBindings": {
            "type": "object",
            "properties": {
              "baseColor": {
                "type": "string"
              },
              "metallicRoughness": {
                "type": "string"
              },
              "normal": {
                "type": "string"
              },
              "occlusion": {
                "type": "string"
              },
              "emissive": {
                "type": "string"
              },
              "reactive": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "worldMatrix",
                "worldBounds",
                "distanceToCamera"
              ],
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "worldMatrix": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": {
                    "type": "number"
                  }
                },
                "previousWorldMatrix": {
                  "type": "array",
                  "minItems": 16,
                  "maxItems": 16,
                  "items": {
                    "type": "number"
                  }
                },
                "worldBounds": {
                  "type": "object"
                },
                "distanceToCamera": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "instanceCount": {
            "type": "integer",
            "minimum": 1
          },
          "temporalReactive": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "packetRoot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "lights": {
      "type": "array"
    },
    "passes": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "shaders": {
      "type": "object"
    },
    "stats": {
      "type": "object",
      "required": [
        "textureCount",
        "materialTextureBindings"
      ],
      "properties": {
        "textureCount": {
          "type": "integer",
          "minimum": 0
        },
        "materialTextureBindings": {
          "type": "integer",
          "minimum": 0
        },
        "visibleInstances": {
          "type": "integer",
          "minimum": 0
        },
        "instancedDraws": {
          "type": "integer",
          "minimum": 0
        },
        "activeCells": {
          "type": "integer",
          "minimum": 0
        },
        "streamedNodes": {
          "type": "integer",
          "minimum": 0
        },
        "streamingCulledCells": {
          "type": "integer",
          "minimum": 0
        },
        "gpuDrivenDraws": {
          "type": "integer",
          "minimum": 0
        },
        "hlodProxyDraws": {
          "type": "integer",
          "minimum": 0
        },
        "hlodSuppressedNodes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRealityRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometryRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commandRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frameRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "textureRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "animationRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "temporalRoot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
