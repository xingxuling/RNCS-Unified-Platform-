{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/vsr-realtime-webgpu-frame.v0.3.schema.json",
  "title": "VSR Realtime WebGPU Frame Plan v0.3",
  "type": "object",
  "required": ["format", "version", "sourceDisplayHash", "visualPlanRoot", "viewport", "stats", "resourceRoot", "commandRoot", "framePlanRoot", "dynamicBindings", "dynamicLightBindings"],
  "properties": {
    "format": {"const": "vsr.realtime-webgpu-frame.v0.3"},
    "version": {"type": "string"},
    "sourceDisplayHash": {"type": "string"},
    "visualPlanRoot": {"type": "string"},
    "visualEvidenceRoot": {"type": "string"},
    "viewport": {"type": "object", "required": ["width", "height", "renderWidth", "renderHeight", "dpr"]},
    "quality": {"type": "string"},
    "stats": {"type": "object"},
    "resourceRoot": {"type": "string"},
    "commandRoot": {"type": "string"},
    "framePlanRoot": {"type": "string"},
    "dynamicBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "entityId", "firstVertex", "vertexCount", "baseX", "baseY"],
        "properties": {
          "nodeId": {"type": "string"},
          "entityId": {"type": "string"},
          "firstVertex": {"type": "integer", "minimum": 0},
          "vertexCount": {"type": "integer", "minimum": 0},
          "baseX": {"type": "number"},
          "baseY": {"type": "number"}
        }
      }
    },
    "dynamicLightBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lightId", "entityId"],
        "properties": {
          "lightId": {"type": "string"},
          "entityId": {"type": "string"},
          "offsetX": {"type": "number"},
          "offsetY": {"type": "number"}
        }
      }
    }
  },
  "additionalProperties": true
}
