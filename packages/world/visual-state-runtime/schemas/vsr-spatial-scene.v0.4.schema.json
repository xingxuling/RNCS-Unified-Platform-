{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-scene.v0.4.schema.json",
  "title": "VSR Spatial Scene v0.4",
  "type": "object",
  "required": [
    "format",
    "sceneId",
    "activeCameraId",
    "meshes",
    "materials",
    "nodes",
    "cameras",
    "lights"
  ],
  "properties": {
    "format": {
      "const": "vsr.spatial-scene.v0.4"
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "activeCameraId": {
      "type": "string",
      "minLength": 1
    },
    "meshes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "positions",
          "indices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "normals": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "uvs": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "baseColor": {
            "type": "string"
          },
          "metallic": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emissive": {
            "type": "string"
          },
          "emissiveStrength": {
            "type": "number",
            "minimum": 0
          },
          "doubleSided": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "occlusionStrength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "clearcoat": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "clearcoatRoughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ior": {
            "type": "number",
            "minimum": 1,
            "maximum": 2.5
          },
          "baseColorTextureId": {
            "type": "string"
          },
          "metallicRoughnessTextureId": {
            "type": "string"
          },
          "normalTextureId": {
            "type": "string"
          },
          "occlusionTextureId": {
            "type": "string"
          },
          "emissiveTextureId": {
            "type": "string"
          },
          "normalScale": {
            "type": "number",
            "minimum": 0
          },
          "alphaMode": {
            "enum": [
              "OPAQUE",
              "MASK",
              "BLEND"
            ]
          },
          "alphaCutoff": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "meshId": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "castShadow": {
            "type": "boolean"
          },
          "receiveShadow": {
            "type": "boolean"
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "transform",
          "projection"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "projection": {
            "enum": [
              "perspective",
              "orthographic"
            ]
          },
          "fovYDeg": {
            "type": "number"
          },
          "orthoHeight": {
            "type": "number"
          },
          "near": {
            "type": "number"
          },
          "far": {
            "type": "number"
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "ambient",
              "directional",
              "point"
            ]
          },
          "color": {
            "type": "string"
          },
          "intensity": {
            "type": "number"
          },
          "castShadow": {
            "type": "boolean"
          }
        }
      }
    },
    "reality": {
      "type": "object",
      "required": [
        "worldId"
      ],
      "properties": {
        "worldId": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "realityRoot": {
          "type": "string"
        },
        "evidenceRoot": {
          "type": "string"
        }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "pixels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "pixels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "colorSpace": {
            "enum": [
              "srgb",
              "linear"
            ]
          },
          "wrapU": {
            "enum": [
              "repeat",
              "clamp"
            ]
          },
          "wrapV": {
            "enum": [
              "repeat",
              "clamp"
            ]
          },
          "filter": {
            "enum": [
              "nearest",
              "linear"
            ]
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration",
          "channels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "path",
                "times",
                "values"
              ],
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "path": {
                  "enum": [
                    "translation",
                    "rotationEulerDeg",
                    "rotationQuaternion",
                    "scale"
                  ]
                },
                "times": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "inTangents": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "outTangents": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "interpolation": {
                  "enum": [
                    "LINEAR",
                    "STEP",
                    "CUBICSPLINE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
