{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rncs.dev/schemas/vsr-spatial-scene.v0.4.schema.json",
  "title": "VSR Spatial Scene v0.4",
  "type": "object",
  "required": [
    "format",
    "sceneId",
    "activeCameraId",
    "meshes",
    "materials",
    "nodes",
    "cameras",
    "lights"
  ],
  "properties": {
    "format": {
      "const": "vsr.spatial-scene.v0.4"
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "properties": {
        "diffuseColor": {
          "type": "string"
        },
        "specularColor": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "textureId": {
          "type": "string",
          "minLength": 1
        },
        "irradianceBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lightmapBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolumeBakeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolume": {
          "$ref": "vsr-spatial-irradiance-volume.v0.1.schema.json"
        },
        "irradianceVolumeFieldRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "irradianceVolumeField": {
          "$ref": "vsr-spatial-irradiance-volume-field.v0.1.schema.json"
        },
        "probes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "position",
              "radius"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "diffuseColor": {
                "type": "string"
              },
              "specularColor": {
                "type": "string"
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 32
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "required": [
        "worldId",
        "cells"
      ],
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "persistentNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "center",
              "radius",
              "nodeIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "center": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "nodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "loadRadius": {
                "type": "number",
                "minimum": 0
              },
              "unloadRadius": {
                "type": "number",
                "minimum": 0
              },
              "priority": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hlod": {
      "type": "object",
      "required": [
        "clusters"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "sourceNodeIds",
              "levels"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceNodeIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "levels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "maxDistance",
                    "proxyNodeIds"
                  ],
                  "properties": {
                    "maxDistance": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "proxyNodeIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "activeCameraId": {
      "type": "string",
      "minLength": 1
    },
    "meshes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "positions",
          "indices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "normals": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "uvs": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "uvs1": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "baseColor": {
            "type": "string"
          },
          "metallic": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emissive": {
            "type": "string"
          },
          "emissiveStrength": {
            "type": "number",
            "minimum": 0
          },
          "doubleSided": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "occlusionStrength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "clearcoat": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "clearcoatRoughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ior": {
            "type": "number",
            "minimum": 1,
            "maximum": 2.5
          },
          "baseColorTextureId": {
            "type": "string"
          },
          "metallicRoughnessTextureId": {
            "type": "string"
          },
          "normalTextureId": {
            "type": "string"
          },
          "occlusionTextureId": {
            "type": "string"
          },
          "emissiveTextureId": {
            "type": "string"
          },
          "lightmapTextureId": {
            "type": "string"
          },
          "lightmapIntensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 8
          },
          "lightmapUvSet": {
            "enum": [
              0,
              1
            ]
          },
          "temporalReactive": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reactiveMaskTextureId": {
            "type": "string"
          },
          "normalScale": {
            "type": "number",
            "minimum": 0
          },
          "alphaMode": {
            "enum": [
              "OPAQUE",
              "MASK",
              "BLEND"
            ]
          },
          "alphaCutoff": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "meshId": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "castShadow": {
            "type": "boolean"
          },
          "receiveShadow": {
            "type": "boolean"
          },
          "temporalReactive": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "transform",
          "projection"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "projection": {
            "enum": [
              "perspective",
              "orthographic"
            ]
          },
          "fovYDeg": {
            "type": "number"
          },
          "orthoHeight": {
            "type": "number"
          },
          "near": {
            "type": "number"
          },
          "far": {
            "type": "number"
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "ambient",
              "directional",
              "point"
            ]
          },
          "color": {
            "type": "string"
          },
          "intensity": {
            "type": "number"
          },
          "castShadow": {
            "type": "boolean"
          }
        }
      }
    },
    "reality": {
      "type": "object",
      "required": [
        "worldId"
      ],
      "properties": {
        "worldId": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "realityRoot": {
          "type": "string"
        },
        "evidenceRoot": {
          "type": "string"
        }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "pixels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "pixels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "colorSpace": {
            "enum": [
              "srgb",
              "linear"
            ]
          },
          "wrapU": {
            "enum": [
              "repeat",
              "clamp"
            ]
          },
          "wrapV": {
            "enum": [
              "repeat",
              "clamp"
            ]
          },
          "filter": {
            "enum": [
              "nearest",
              "linear"
            ]
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration",
          "channels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "path",
                "times",
                "values"
              ],
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "path": {
                  "enum": [
                    "translation",
                    "rotationEulerDeg",
                    "rotationQuaternion",
                    "scale"
                  ]
                },
                "times": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "inTangents": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "outTangents": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "interpolation": {
                  "enum": [
                    "LINEAR",
                    "STEP",
                    "CUBICSPLINE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
