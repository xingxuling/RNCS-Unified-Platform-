{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/rsr-spatial-heightfield-mutation.v0.1.schema.json",
  "title": "RSR Spatial Heightfield Mutation Event v0.1",
  "type": "object",
  "required": [
    "kind",
    "phase",
    "format",
    "version",
    "tick",
    "bodyId",
    "fixtureId",
    "samples",
    "previousHeightfieldRoot",
    "nextHeightfieldRoot",
    "mutationRoot"
  ],
  "properties": {
    "kind": { "const": "terrain-mutation" },
    "phase": { "const": "patch" },
    "format": { "const": "rsr.spatial-heightfield-mutation.v0.1" },
    "version": { "const": "0.1.0" },
    "tick": { "type": "integer", "minimum": 1 },
    "bodyId": { "type": "string", "minLength": 1 },
    "fixtureId": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["index", "height"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "previousHeightfieldRoot": { "type": "string", "minLength": 1 },
    "nextHeightfieldRoot": { "type": "string", "minLength": 1 },
    "mutationRoot": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
