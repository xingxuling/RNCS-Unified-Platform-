{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/rsr-experience-fabric.v0.4.schema.json",
  "title": "RSR Temporal Experience Fabric v0.4",
  "type": "object",
  "required": ["format", "experienceId", "tickHz", "seed"],
  "properties": {
    "format": { "const": "rsr.experience-fabric.v0.4" },
    "experienceId": { "type": "string", "minLength": 1 },
    "tickHz": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "durationTicks": { "type": "integer", "minimum": 1 },
    "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } },
    "animators": { "type": "array", "items": { "$ref": "#/$defs/animator" } },
    "skeletons": { "type": "array", "items": { "$ref": "#/$defs/skeleton" } },
    "audioCues": { "type": "array", "items": { "$ref": "#/$defs/audioCue" } },
    "audioBuses": { "type": "array", "items": { "$ref": "#/$defs/audioBus" } },
    "listener": { "$ref": "#/$defs/listener" },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "initialEvents": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "additionalProperties": false,
  "$defs": {
    "vec2": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false },
    "color": { "type": "object", "required": ["r", "g", "b", "a"], "properties": { "r": { "type": "number" }, "g": { "type": "number" }, "b": { "type": "number" }, "a": { "type": "number" } }, "additionalProperties": false },
    "keyframe": { "type": "object", "required": ["tick", "value"], "properties": { "tick": { "type": "integer", "minimum": 0 }, "value": { "type": "number" }, "interpolation": { "enum": ["step", "linear", "smooth", "ease-in", "ease-out", "ease-in-out", "spring"] }, "inTangent": { "type": "number" }, "outTangent": { "type": "number" } }, "additionalProperties": false },
    "track": { "type": "object", "required": ["target", "keyframes"], "properties": { "target": { "type": "string" }, "keyframes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keyframe" } } }, "additionalProperties": false },
    "marker": { "type": "object", "required": ["id", "tick", "eventType"], "properties": { "id": { "type": "string" }, "tick": { "type": "integer", "minimum": 0 }, "eventType": { "type": "string" }, "data": { "type": "object" } }, "additionalProperties": false },
    "clip": { "type": "object", "required": ["id", "durationTicks", "tracks"], "properties": { "id": { "type": "string" }, "durationTicks": { "type": "integer", "minimum": 1 }, "loop": { "type": "boolean" }, "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } }, "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } } }, "additionalProperties": false },
    "condition": { "type": "object", "required": ["parameter", "op"], "properties": { "parameter": { "type": "string" }, "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "truthy", "falsy", "trigger"] }, "value": {} }, "additionalProperties": false },
    "transition": { "type": "object", "required": ["id", "from", "to"], "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "durationTicks": { "type": "integer", "minimum": 1 }, "exitTimeQ": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "priority": { "type": "integer" }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }, "additionalProperties": false },
    "state": { "type": "object", "required": ["id", "clipId"], "properties": { "id": { "type": "string" }, "clipId": { "type": "string" }, "speedQ": { "type": "integer" }, "loop": { "type": "boolean" }, "tags": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "layer": { "type": "object", "required": ["id", "initialState", "states"], "properties": { "id": { "type": "string" }, "initialState": { "type": "string" }, "weightQ": { "type": "integer" }, "mode": { "enum": ["override", "additive"] }, "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } }, "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } } }, "additionalProperties": false },
    "animator": { "type": "object", "required": ["id", "layers"], "properties": { "id": { "type": "string" }, "parameters": { "type": "object", "additionalProperties": { "type": ["number", "boolean"] } }, "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } } }, "additionalProperties": false },
    "bone": { "type": "object", "required": ["id", "length"], "properties": { "id": { "type": "string" }, "parentId": { "type": "string" }, "length": { "type": "number", "minimum": 0 }, "restPosition": { "$ref": "#/$defs/vec2" }, "restRotation": { "type": "number" }, "restScale": { "$ref": "#/$defs/vec2" } }, "additionalProperties": false },
    "ik": { "type": "object", "required": ["id", "rootBone", "midBone", "endBone", "targetXParameter", "targetYParameter"], "properties": { "id": { "type": "string" }, "rootBone": { "type": "string" }, "midBone": { "type": "string" }, "endBone": { "type": "string" }, "targetXParameter": { "type": "string" }, "targetYParameter": { "type": "string" }, "weightParameter": { "type": "string" }, "bend": { "enum": [1, -1] } }, "additionalProperties": false },
    "skeleton": { "type": "object", "required": ["id", "bones"], "properties": { "id": { "type": "string" }, "bones": { "type": "array", "items": { "$ref": "#/$defs/bone" } }, "ik": { "type": "array", "items": { "$ref": "#/$defs/ik" } } }, "additionalProperties": false },
    "envelope": { "type": "object", "properties": { "attackMs": { "type": "number", "minimum": 0 }, "decayMs": { "type": "number", "minimum": 0 }, "sustainQ": { "type": "integer" }, "releaseMs": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
    "voice": { "type": "object", "required": ["id", "source", "durationMs"], "properties": { "id": { "type": "string" }, "source": { "type": "object" }, "durationMs": { "type": "number", "minimum": 1 }, "gainQ": { "type": "integer" }, "panQ": { "type": "integer" }, "priority": { "type": "integer" }, "busId": { "type": "string" }, "envelope": { "$ref": "#/$defs/envelope" }, "detuneCents": { "type": "number" }, "spatial": { "type": "object" } }, "additionalProperties": false },
    "audioCue": { "type": "object", "required": ["id", "voices"], "properties": { "id": { "type": "string" }, "voices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/voice" } }, "maxInstances": { "type": "integer", "minimum": 1 }, "cooldownTicks": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "audioBus": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "parentId": { "type": "string" }, "gainQ": { "type": "integer" }, "lowPassHz": { "type": "number", "minimum": 20 }, "delayMs": { "type": "number", "minimum": 0 }, "delayFeedbackQ": { "type": "integer" } }, "additionalProperties": false },
    "listener": { "type": "object", "required": ["position"], "properties": { "position": { "$ref": "#/$defs/vec2" }, "facing": { "$ref": "#/$defs/vec2" } }, "additionalProperties": false },
    "numberCurve": { "type": "array", "items": { "type": "object", "required": ["tQ", "value"], "properties": { "tQ": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "value": { "type": "number" } }, "additionalProperties": false } },
    "colorCurve": { "type": "array", "items": { "type": "object", "required": ["tQ", "color"], "properties": { "tQ": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "color": { "$ref": "#/$defs/color" } }, "additionalProperties": false } },
    "emitter": { "type": "object", "required": ["id", "maxParticles", "lifetimeTicks", "spawn", "speed", "angleTurnsQ"], "properties": { "id": { "type": "string" }, "rateQ": { "type": "integer" }, "bursts": { "type": "array", "items": { "type": "object", "required": ["tick", "count"], "properties": { "tick": { "type": "integer", "minimum": 0 }, "count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "maxParticles": { "type": "integer", "minimum": 1 }, "lifetimeTicks": { "type": "object" }, "spawn": { "type": "object" }, "speed": { "type": "object" }, "angleTurnsQ": { "type": "object" }, "gravity": { "$ref": "#/$defs/vec2" }, "dragQ": { "type": "integer" }, "angularVelocity": { "type": "object" }, "sizeCurve": { "$ref": "#/$defs/numberCurve" }, "opacityCurve": { "$ref": "#/$defs/numberCurve" }, "colorCurve": { "$ref": "#/$defs/colorCurve" }, "collision": { "type": "object" }, "blend": { "enum": ["normal", "additive", "screen"] }, "tags": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "screenEffect": { "type": "object", "required": ["type", "durationTicks", "intensityQ"], "properties": { "type": { "enum": ["shake", "flash", "chromatic-aberration", "time-dilation"] }, "startTick": { "type": "integer", "minimum": 0 }, "durationTicks": { "type": "integer", "minimum": 1 }, "intensityQ": { "type": "integer" }, "color": { "$ref": "#/$defs/color" } }, "additionalProperties": false },
    "effect": { "type": "object", "required": ["id", "durationTicks"], "properties": { "id": { "type": "string" }, "durationTicks": { "type": "integer", "minimum": 1 }, "emitters": { "type": "array", "items": { "$ref": "#/$defs/emitter" } }, "screenEffects": { "type": "array", "items": { "$ref": "#/$defs/screenEffect" } }, "maxInstances": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "action": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["animation-trigger", "set-animation-parameter", "audio-cue", "effect", "emit-event"] }, "animatorId": { "type": "string" }, "parameter": { "type": "string" }, "value": {}, "cueId": { "type": "string" }, "gainFromIntensity": { "type": "boolean" }, "effectId": { "type": "string" }, "atEventPosition": { "type": "boolean" }, "eventType": { "type": "string" }, "data": { "type": "object" } }, "additionalProperties": false },
    "binding": { "type": "object", "required": ["id", "eventType", "actions"], "properties": { "id": { "type": "string" }, "eventType": { "type": "string" }, "minIntensityQ": { "type": "integer" }, "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } } }, "additionalProperties": false },
    "event": { "type": "object", "required": ["id", "tick", "type"], "properties": { "id": { "type": "string" }, "tick": { "type": "integer", "minimum": 0 }, "type": { "type": "string" }, "position": { "$ref": "#/$defs/vec2" }, "intensityQ": { "type": "integer" }, "subjectId": { "type": "string" }, "data": { "type": "object" } }, "additionalProperties": false }
  }
}
