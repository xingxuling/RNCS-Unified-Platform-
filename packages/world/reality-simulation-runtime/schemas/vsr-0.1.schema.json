{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/vsr-0.1.schema.json",
  "title": "Visual State Runtime Document 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "metadata", "canvas", "nodes"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "runtimeTarget": { "type": "string" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "variables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "interactions": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "value": {
      "anyOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    },
    "length": { "anyOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?:%|vw|vh)$|^auto$" }] },
    "paint": {
      "oneOf": [
        { "type": "object", "required": ["type", "color"], "properties": { "type": { "const": "solid" }, "color": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "x1", "y1", "x2", "y2", "stops"], "properties": { "type": { "const": "linear-gradient" }, "x1": { "type": "number" }, "y1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" }, "stops": { "type": "array", "items": { "type": "object", "required": ["offset", "color"], "properties": { "offset": { "type": "number" }, "color": { "type": "string" } }, "additionalProperties": false } } }, "additionalProperties": false }
      ]
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "duration", "defaultFps", "seed"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "duration": { "type": "number", "minimum": 0 }, "defaultFps": { "type": "number", "exclusiveMinimum": 0 }, "seed": { "type": "integer" }, "authoringTool": { "type": "string" }, "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }, "description": { "type": "string" } }
    },
    "canvas": {
      "type": "object", "required": ["width", "height"], "additionalProperties": false,
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "pixelRatio": { "type": "number", "exclusiveMinimum": 0 }, "background": { "$ref": "#/$defs/paint" }, "layoutMode": { "enum": ["fixed", "responsive"] }, "safeArea": { "type": "object" } }
    },
    "layout": {
      "type": "object",
      "properties": { "x": { "$ref": "#/$defs/length" }, "y": { "$ref": "#/$defs/length" }, "width": { "$ref": "#/$defs/length" }, "height": { "$ref": "#/$defs/length" }, "anchorX": { "type": "number" }, "anchorY": { "type": "number" }, "minWidth": { "type": "number" }, "maxWidth": { "type": "number" }, "minHeight": { "type": "number" }, "maxHeight": { "type": "number" }, "aspectRatio": { "type": "number" }, "alignSelf": { "enum": ["start", "center", "end", "stretch"] }, "padding": { "type": "object" }, "margin": { "type": "object" }, "responsive": { "type": "array" } },
      "additionalProperties": false
    },
    "node": {
      "type": "object", "required": ["id", "type"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "enum": ["group", "rect", "ellipse", "line", "path", "text", "image"] }, "name": { "type": "string" }, "parentId": { "type": "string" }, "zIndex": { "type": "number" }, "order": { "type": "number" }, "active": { "type": "object" }, "visible": {}, "layout": { "$ref": "#/$defs/layout" }, "transform": { "type": "object" }, "appearance": { "type": "object" }, "tracks": { "type": "array", "items": { "type": "object", "required": ["id", "property", "mode"] } }, "tags": { "type": "array", "items": { "type": "string" } }, "data": { "type": "object" }, "content": { "type": "object" }, "extensions": { "type": "object" } },
      "additionalProperties": false
    },
    "asset": {
      "type": "object", "required": ["id", "type", "src"],
      "properties": { "id": { "type": "string" }, "type": { "enum": ["image", "font", "json", "binary"] }, "src": { "type": "string" }, "contentHash": { "type": "string" }, "mimeType": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" }, "policy": { "type": "object" } },
      "additionalProperties": false
    },
    "event": {
      "type": "object", "required": ["id", "time", "type", "target"],
      "properties": { "id": { "type": "string" }, "time": { "type": "number" }, "type": { "enum": ["set", "merge", "increment", "toggle", "custom"] }, "target": { "type": "string" }, "value": { "$ref": "#/$defs/value" }, "payload": { "type": "object" }, "order": { "type": "number" } },
      "additionalProperties": false
    },
    "output": {
      "type": "object", "required": ["id", "type"],
      "properties": { "id": { "type": "string" }, "type": { "enum": ["image", "video", "interactive"] }, "width": { "type": "number" }, "height": { "type": "number" }, "fps": { "type": "number" }, "codec": { "type": "string" }, "responsive": { "type": "boolean" } },
      "additionalProperties": false
    }
  }
}
