{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.example/schemas/rsr-spatial-embodiment.v0.5.schema.json",
  "title": "RSR Spatial Embodiment World v0.5",
  "type": "object",
  "required": ["format", "worldId", "stepHz", "bodies"],
  "properties": {
    "format": { "const": "rsr.spatial-embodiment-world.v0.5" },
    "worldId": { "type": "string", "minLength": 1 },
    "stepHz": { "type": "number", "exclusiveMinimum": 0 },
    "floorY": { "type": "number" },
    "bodies": { "type": "array", "minItems": 1 },
    "characters": { "type": "array" },
    "joints": { "type": "array" },
    "listeners": { "type": "array" },
    "reality": { "type": "object" }
  },
  "additionalProperties": true
}
