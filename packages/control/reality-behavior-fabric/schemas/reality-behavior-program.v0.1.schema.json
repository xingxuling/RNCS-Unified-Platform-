{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://taowind.example/schemas/reality-behavior-program.v0.1.schema.json",
  "title":"Reality Behavior Program v0.1",
  "type":"object",
  "required":["format","version","identity","seed","tick_rate","entities","state_machines","behavior_trees","rules","capabilities","authority","program_root"],
  "properties":{
    "format":{"const":"reality-behavior.program.v0.1"},
    "version":{"const":"0.1.0"},
    "identity":{"type":"object","required":["program_id","title","version"],"properties":{"program_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"description":{"type":"string"},"version":{"type":"string"}}},
    "seed":{"type":"string"},
    "tick_rate":{"type":"integer","minimum":1,"maximum":1000},
    "input_actions":{"type":"array","items":{"type":"object"}},
    "globals":{"type":"object"},
    "entities":{"type":"array","items":{"type":"object","required":["entity_id"],"properties":{"entity_id":{"type":"string"},"machine_id":{"type":"string"},"tree_id":{"type":"string"},"variables":{"type":"object"},"components":{"type":"object"}}}},
    "prefabs":{"type":"array","items":{"type":"object"}},
    "state_machines":{"type":"array","items":{"type":"object","required":["machine_id","entity_id","initial_state","states"]}},
    "behavior_trees":{"type":"array","items":{"type":"object","required":["tree_id","entity_id","root"]}},
    "rules":{"type":"array","items":{"type":"object","required":["rule_id","event","actions"]}},
    "capabilities":{"type":"array","items":{"type":"object","required":["capability_id"]}},
    "authority":{"type":"object","required":["default_effect","policies"]},
    "systems":{"type":"array","items":{"type":"string"}},
    "metadata":{"type":"object"},
    "program_root":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
