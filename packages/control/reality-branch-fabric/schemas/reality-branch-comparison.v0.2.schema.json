{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reality Branch Comparison v0.2",
  "type": "object",
  "required": [
    "format",
    "version",
    "workspace_root",
    "rows",
    "pareto_frontier",
    "sensitivity",
    "conflict_matrix",
    "comparison_root"
  ],
  "properties": {
    "format": {
      "const": "reality-branch.comparison.v0.2"
    },
    "version": {
      "const": "0.2.0-alpha.1"
    },
    "workspace_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array"
    },
    "pareto_frontier": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_branch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommendation_stability_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "sensitivity": {
      "type": "array"
    },
    "conflict_matrix": {
      "type": "array"
    },
    "comparison_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
