{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reality Branch Authority Decision v0.2",
  "type": "object",
  "required": [
    "format",
    "version",
    "decision_id",
    "request_root",
    "proposal_root",
    "decision",
    "authority_actor",
    "decision_root"
  ],
  "properties": {
    "format": {
      "const": "reality-branch.authority-decision.v0.2"
    },
    "version": {
      "const": "0.2.0-alpha.1"
    },
    "decision_id": {
      "type": "string"
    },
    "request_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "approved",
        "denied"
      ]
    },
    "authority_actor": {
      "type": "string"
    },
    "conditions": {
      "type": "array"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
