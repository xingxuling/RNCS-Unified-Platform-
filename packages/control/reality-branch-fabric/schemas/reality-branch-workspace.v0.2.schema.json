{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.dev/schemas/reality-branch-workspace.v0.2.schema.json",
  "title": "Reality Branch Workspace v0.2",
  "type": "object",
  "required": [
    "format",
    "version",
    "workspace_id",
    "base",
    "base_state",
    "branches",
    "weights",
    "scenarios",
    "authority_policy",
    "workspace_root"
  ],
  "properties": {
    "format": {
      "const": "reality-branch.workspace.v0.2"
    },
    "version": {
      "const": "0.2.0-alpha.1"
    },
    "workspace_id": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "required": [
        "reality_id",
        "generation",
        "generation_root",
        "branch_id",
        "project_root"
      ],
      "properties": {
        "reality_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "generation_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "branch_id": {
          "type": "string"
        },
        "project_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base_state": {
      "type": "object"
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "reality-branch-candidate.v0.2.schema.json"
      }
    },
    "weights": {
      "type": "object",
      "required": [
        "benefit",
        "confidence",
        "resilience",
        "risk",
        "cost",
        "duration"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "probability_bps"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "probability_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "metric_adjustments": {
            "type": "object"
          }
        }
      }
    },
    "authority_policy": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "workspace_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
