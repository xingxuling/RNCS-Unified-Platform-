{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
  "required":["format","request_id","protocol_versions","subject","host","goals","policy","constraints","request_root"],
  "properties":{
    "format":{"const":"cnp.negotiation-request.v0.1"},"request_id":{"type":"string"},
    "protocol_versions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "subject":{"type":"object","required":["subject_id","scopes"]},
    "host":{"type":"object","required":["capabilities"]},
    "goals":{"type":"array","minItems":1,"items":{"type":"object","required":["type"]}},
    "policy":{"type":"object","required":["max_risk","require_reversible","required_evidence","minimum_trust","cost_budget"]},
    "request_root":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },"additionalProperties":true
}
