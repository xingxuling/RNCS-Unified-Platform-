{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICAR Application Result v0.5",
  "type": "object",
  "required": [
    "format",
    "status",
    "artifact",
    "envelope",
    "rfe",
    "result_root"
  ],
  "properties": {
    "format": {
      "const": "icar.application-result.v0.5"
    },
    "status": {
      "const": "projected"
    },
    "result_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}