{
  "format": "reality-one.runtime-manifest.v0.3",
  "runtime_id": "rncs.rbf",
  "runtime_version": "0.2.0-alpha.1",
  "display_name": "Reality Branch Fabric",
  "gateway_protocol_versions": [
    "0.3.0"
  ],
  "transport": {
    "kind": "node-module",
    "package": "@taowind/reality-branch-fabric"
  },
  "bridge": "../src/bridges/rbf.bridge.mjs",
  "actions": [
    "health",
    "createWorkspace",
    "validateWorkspace",
    "simulateBranch",
    "compareBranches",
    "createMergeProposal",
    "createAuthorityRequest",
    "issueAuthorityDecision",
    "createTransitionDraft",
    "applyMergeProposal",
    "rebaseWorkspace"
  ],
  "protocols": [
    "reality-branch.v0.2",
    "rncs.reality-transition-envelope.v0.1"
  ],
  "requires": [
    {
      "runtime_id": "rncs.core",
      "version_range": "^0.1.0"
    },
    {
      "runtime_id": "rncs.aaf",
      "version_range": "^0.1.0",
      "optional": true
    },
    {
      "runtime_id": "rncs.rfe",
      "version_range": "^0.1.0",
      "optional": true
    }
  ],
  "priority": 100
}
