{
  "format": "reality-one.runtime-manifest.v0.3",
  "runtime_id": "rncs.rcl-control",
  "runtime_version": "0.4.0-alpha.1",
  "display_name": "RCL Native and Authoritative RNCS Runtime",
  "gateway_protocol_versions": ["0.3.0"],
  "transport": {
    "kind": "node-module",
    "package": "@taowind/rncs-rcl-control-plane"
  },
  "bridge": "../src/bridges/rcl-control.bridge.mjs",
  "actions": ["health", "compileExecute", "compileAuthorityPlan", "authorityWorkflow", "controlPlane"],
  "protocols": [
    "rncs.rcl-control.v0.3",
    "rncs.rcl-control.v0.4",
    "rncs.rcl-authority.v0.1",
    "rcl.native.execute.v0.1",
    "rcl.native.parity.v0.1",
    "rcl.bootstrap.stage5.v0.1"
  ],
  "requires": [
    {"runtime_id": "rncs.rsr", "version_range": ">=0.9.0-alpha.1 <0.10.0", "optional": true},
    {"runtime_id": "rncs.vsr", "version_range": ">=0.8.0-alpha.1 <0.9.0", "optional": true}
  ],
  "priority": 80,
  "health_timeout_ms": 2000,
  "metadata": {
    "authority": "candidate-and-explicit-authority-commit",
    "source_of_truth": "packages/languages/reality-computation-language"
  }
}
