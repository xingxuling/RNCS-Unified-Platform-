{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "env": {
    "TAOWIND_VERCEL_APP": "turi",
    "TURI_HOST": "0.0.0.0",
    "TURI_MCP_PATH": "/mcp",
    "TURI_MCP_STATELESS": "true",
    "TURI_REASONING_MODE": "host",
    "TURI_HOST_RESUME_TTL_MS": "7200000",
    "TURI_AUTH_MODE": "none",
    "TURI_ALLOW_PUBLIC_NO_AUTH": "true",
    "TURI_ALLOWED_HOSTS": "*",
    "TURI_ALLOWED_ORIGINS": "https://chatgpt.com,https://chat.openai.com",
    "TURI_TRUST_PROXY": "true",
    "TURI_REPO_ROOT": "/var/task",
    "TURI_MANIFEST_DIRS": "/var/task/packages/control/reality-one-gateway/runtimes",
    "TURI_RCL_ROOT": "/var/task/packages/languages/reality-computation-language",
    "TURI_RCL_CONTROL_PLANE_DIR": "/var/task/packages/control/rncs-rcl-control-plane",
    "TURI_UPDIA_BRIDGE_DISCOVERY_URL": "https://gist.githubusercontent.com/xingxuling/6b9edb59043baed2488bcbe3f5031146/raw/updia-bridge-route.json",
    "TURI_UPDIA_BRIDGE_DISCOVERY_FILE": "updia-bridge-route.json",
    "TURI_UPDIA_BRIDGE_ALLOWED_HOST_SUFFIXES": ".trycloudflare.com",
    "TURI_UPDIA_BRIDGE_DISCOVERY_CACHE_MS": "30000",
    "TURI_UPDIA_BRIDGE_DISCOVERY_CACHE_BUST_MS": "60000",
    "TURI_UPDIA_BRIDGE_ASYNC": "true",
    "TURI_UPDIA_BRIDGE_POLL_MS": "1000",
    "TURI_UPDIA_DEFAULT_MAX_TOKENS": "512",
    "TURI_AUTHORITY_MODE": "candidate",
    "TURI_ENABLE_AUTHORIZED_WRITES": "false",
    "TURI_ENABLE_EXTERNAL_EFFECTS": "false",
    "TURI_DATA_DIR": "/tmp/turi-mcp"
  },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "packages/**"
    }
  },
  "routes": [
    {
      "src": "/(?<path>.*)",
      "dest": "/api/index?__path=/$path"
    }
  ]
}
